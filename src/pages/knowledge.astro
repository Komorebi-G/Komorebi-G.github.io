---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { getPublishedProblems, formatDate, normalizeSearchText } from "../lib/problems";
import { getPublishedTopics, getProblemsForTopic, topicRecords } from "../lib/tag-knowledge";
import { buildTagCatalog } from "../lib/tags.mjs";
const topics = getPublishedTopics(await getCollection("tagKnowledge"));
const problems = getPublishedProblems(await getCollection("problems"));
const unfinished = buildTagCatalog(problems.map((problem) => problem.data), topicRecords(topics)).filter((tag) => !tag.topicId);
const showEditor = import.meta.env.DEV;
---
<BaseLayout title="知识点 — LBH" description="算法知识、代码模板与相关题解。" themeColor="#fafbf7">
  <Navbar />
  <main id="main-content">
    <header class="page-heading">
      <p class="eyebrow">NOTES / 知识目录</p>
      <div class="heading-row"><div><h1>知识点</h1><p>算法概念、代码模板与易错点，关联到具体题目。</p></div>{showEditor && <a class="primary-link" href="/topic-editor/?new=1">＋ 写知识点</a>}</div>
    </header>
    <div class="search-wrap"><label class="sr-only" for="knowledge-search">搜索知识点</label><input id="knowledge-search" type="search" placeholder="搜索名称、概念或正文" autocomplete="off" /><kbd aria-hidden="true">/</kbd></div>
    <div class="list-heading"><span id="knowledge-count" aria-live="polite">{topics.length} 个知识点</span><span>更新时间</span></div>
    <section class="knowledge-list" aria-label="知识点目录">
      {topics.map((topic) => (
        <article class="knowledge-row" data-topic-row data-search={normalizeSearchText([topic.data.title, ...topic.data.aliases, topic.data.summary, topic.body].join(" "))}>
          <a class="topic-main" href={`/problems/tags/${topic.id}`}><strong>{topic.data.title}</strong><p>{topic.data.summary}</p><span>{getProblemsForTopic(topic, problems).length} 道相关题目</span></a>
          <div class="topic-side"><time datetime={topic.data.updatedAt.toISOString()}>{formatDate(topic.data.updatedAt)}</time><div><a href={`/problems/tags/${topic.id}`} aria-label={`阅读 ${topic.data.title}`}>阅读 →</a>{showEditor && <a href={`/topic-editor/?id=${encodeURIComponent(topic.id)}`} aria-label={`编辑 ${topic.data.title}`}>编辑</a>}</div></div>
        </article>
      ))}
    </section>
    <p id="knowledge-empty" class="empty" hidden={topics.length > 0}>暂无知识点。</p>
    {showEditor && unfinished.length > 0 && (
      <section class="unfinished"><h2>待整理的标签 <span>{unfinished.length}</span></h2><p>这些标签已有题目，可以继续整理对应的知识点。</p><div>{unfinished.map((tag) => <a href={`/topic-editor/?tag=${encodeURIComponent(tag.name)}`}>{tag.name}<span>{tag.count} 题 ＋</span></a>)}</div></section>
    )}
    <footer><span>LBH · 学习笔记</span><a href="/problems">题目归档 →</a></footer>
  </main>
  <script>
    import { normalizeName } from "../lib/tags.mjs";
    const search = document.querySelector<HTMLInputElement>("#knowledge-search");
    const rows = [...document.querySelectorAll<HTMLElement>("[data-topic-row]")];
    function filter() {
      const query = normalizeName(search?.value || "");
      let count = 0;
      for (const row of rows) { row.hidden = !row.dataset.search?.includes(query); if (!row.hidden) count++; }
      const counter = document.querySelector("#knowledge-count");
      if (counter) counter.textContent = `${count} 个知识点`;
      const empty = document.querySelector<HTMLElement>("#knowledge-empty");
      if (empty) { empty.hidden = count > 0; empty.textContent = query ? "没有匹配的知识点，试试其他关键词。" : "暂无知识点。"; }
      const url = new URL(location.href);
      search?.value.trim() ? url.searchParams.set("q", search.value.trim()) : url.searchParams.delete("q");
      history.replaceState(null, "", url.pathname + url.search);
    }
    if (search) search.value = new URLSearchParams(location.search).get("q") || "";
    search?.addEventListener("input", filter);
    filter();
    document.addEventListener("keydown", (event) => {
      if (event.key === "/" && !(event.target instanceof Element && event.target.closest("input, textarea, select, [contenteditable]"))) { event.preventDefault(); search?.focus(); }
    });
  </script>
</BaseLayout>
<style>
  main { width: min(1040px, calc(100% - 112px)); margin: 0 auto; padding: 45px 0 28px; }
  .eyebrow { margin: 0 0 25px; color: #64725b; font: 12px/1.4 "IBM Plex Mono", monospace; letter-spacing: .04em; }
  .heading-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  h1 { margin: 0; color: #2d432f; font: 500 36px/1.4 "Noto Serif SC", "Songti SC", serif; }
  .heading-row p { margin: 14px 0 0; color: #626c5f; font-size: 14px; line-height: 1.8; }
  .primary-link { flex-shrink: 0; padding: 11px 17px; color: #fff; background: #365841; border-radius: 6px; font-size: 13px; text-decoration: none; }
  .search-wrap { display: flex; align-items: center; position: relative; margin-top: 30px; }
  .search-wrap input { width: 100%; height: 48px; padding: 0 54px 0 17px; color: #293329; background: #fff; border: 1px solid #dbe1d4; border-radius: 7px; font-size: 14px; }
  .search-wrap kbd { position: absolute; right: 15px; padding: 3px 7px; color: #677361; background: #f3f5ef; border: 1px solid #e2e6db; border-radius: 4px; font: 12px/1.2 monospace; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .list-heading { display: flex; justify-content: space-between; padding: 25px 0 15px; color: #64725b; border-bottom: 1px solid #dfe5d8; font-size: 12px; }
  .knowledge-row { display: flex; justify-content: space-between; gap: 36px; padding: 24px 0; border-bottom: 1px solid #e5e9df; }
  .topic-main { display: block; min-width: 0; color: #2f452e; text-decoration: none; }
  .topic-main strong { font-size: 18px; font-weight: 600; }
  .topic-main p { display: -webkit-box; overflow: hidden; max-width: 690px; margin: 10px 0 9px; color: #626c5f; font-size: 14px; line-height: 1.8; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .topic-main span { color: #607654; font-size: 12px; }
  .topic-main:hover strong { color: #527b3e; }
  .topic-side { flex-shrink: 0; text-align: right; }
  time { color: #66745d; font: 12px/1.5 "IBM Plex Mono", monospace; }
  .topic-side > div { display: flex; justify-content: flex-end; gap: 15px; margin-top: 18px; }
  .topic-side a { color: #4e6a42; font-size: 13px; text-decoration: none; }
  .topic-side a:hover { text-decoration: underline; }
  .empty { padding: 45px 0; color: #626c5f; font-size: 14px; }
  .unfinished { margin-top: 38px; padding: 24px; background: #f0f3e9; border: 1px solid #e1e7d9; border-radius: 7px; }
  .unfinished h2 { margin: 0; color: #3e5136; font-size: 15px; font-weight: 600; }
  .unfinished h2 span { margin-left: 8px; color: #67745f; font-size: 12px; }
  .unfinished p { margin: 9px 0 17px; color: #626c5f; font-size: 13px; line-height: 1.8; }
  .unfinished > div { display: flex; flex-wrap: wrap; gap: 10px; }
  .unfinished a { padding: 8px 12px; color: #3e5136; background: #fff; border: 1px solid #dbe2d2; border-radius: 5px; font-size: 13px; text-decoration: none; }
  .unfinished a span { margin-left: 12px; color: #67745f; font-size: 12px; }
  footer { display: flex; justify-content: space-between; margin-top: 40px; padding-top: 24px; color: #66745d; border-top: 1px solid #e0e5da; font-size: 12px; }
  footer a { text-decoration: none; }
  @media (max-width: 1100px) { main { width: calc(100% - 64px); } }
  @media (max-width: 760px) { main { width: calc(100% - 40px); padding-top: 28px; } .heading-row { align-items: flex-start; flex-direction: column; gap: 18px; } h1 { font-size: 30px; } .knowledge-row { gap: 18px; } .topic-main strong { font-size: 16px; } .topic-side time { font-size: 11px; } .unfinished { padding: 20px; } }
</style>
