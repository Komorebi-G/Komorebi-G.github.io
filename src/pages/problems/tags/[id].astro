---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import { formatDate, getPublishedProblems, type ProblemEntry } from "../../../lib/problems";
import {
  getProblemsForTopic,
  getPublishedTopics,
  type TopicEntry,
} from "../../../lib/tag-knowledge";

export async function getStaticPaths() {
  const topics = getPublishedTopics(await getCollection("tagKnowledge"));
  const problems = getPublishedProblems(await getCollection("problems"));

  return topics.map((topic) => ({
    params: { id: topic.id },
    props: {
      topic,
      relatedProblems: getProblemsForTopic(topic, problems),
    },
  }));
}

interface Props {
  topic: TopicEntry;
  relatedProblems: ProblemEntry[];
}

const { topic, relatedProblems } = Astro.props;
const { Content, headings } = await render(topic);
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showEditor = import.meta.env.DEV;
---

<BaseLayout
  title={`${topic.data.title} — 标签知识点`}
  description={topic.data.summary}
  themeColor="#f7f7f4"
>
  <div class="topic-page">
    <Navbar />

    <main id="main-content">
      <a class="back-link" href="/knowledge">← 知识点目录</a>

      <header class="topic-header">
        <p class="eyebrow">TAG KNOWLEDGE</p>
        <h1>{topic.data.title}</h1>
        <p class="summary">{topic.data.summary}</p>
        <div class="header-meta">
          <span>更新于 {formatDate(topic.data.updatedAt)}</span>
          <i />
          <span>{relatedProblems.length} 道相关题目</span>
        </div>
        {
          showEditor && (
            <div class="header-actions">
              <a class="edit-button" href={`/topic-editor/?id=${encodeURIComponent(topic.id)}`}>
                编辑知识点
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m10.8 2.7 2.5 2.5M3 13l.7-3.2 7.8-7.8 2.5 2.5-7.8 7.8L3 13Z" />
                </svg>
              </a>
            </div>
          )
        }
      </header>

      <div id="正文" class:list={{ "reading-layout": true, "has-outline": outline.length > 0 }}>
        {
          outline.length > 0 && (
            <aside class="article-outline">
              <p>本页目录</p>
              <nav aria-label="专题目录">
                {outline.map((heading) => (
                  <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                ))}
              </nav>
            </aside>
          )
        }

        <article class="prose">
          <Content />
        </article>
      </div>

      {
        relatedProblems.length > 0 && (
          <section class="related">
            <header class="section-label">
              <span>RELATED</span>
              <h2>相关题目</h2>
              <b>{relatedProblems.length}</b>
            </header>
            <div class="related-list">
              {relatedProblems.map((problem) => (
                <a href={`/problems/${problem.id}`}>
                  <span>
                    <small>{problem.data.platform} · {formatDate(problem.data.solvedAt)}</small>
                    <strong>{problem.data.title}</strong>
                  </span>
                  <em>{problem.data.tags.join(" · ")}</em>
                  <b>→</b>
                </a>
              ))}
            </div>
          </section>
        )
      }

    </main>

    <footer><span>TAG KNOWLEDGE</span><span>LAST UPDATED · {formatDate(topic.data.updatedAt)}</span></footer>
  </div>


</BaseLayout>

<style>

  main { width: min(1000px, calc(100% - 112px)); margin: 0 auto; padding: 40px 0 28px; }
  .back-link { display: inline-block; margin-bottom: 25px; color: #58704e; font-size: 13px; text-decoration: none; }
  .topic-header { padding-bottom: 26px; border-bottom: 1px solid #dfe5d8; }
  .eyebrow { margin: 0 0 15px; color: #64725b; font: 12px/1.4 "IBM Plex Mono", monospace; letter-spacing: .04em; }
  h1 { margin: 0; color: #2d432f; font: 500 36px/1.4 "Noto Serif SC", "Songti SC", serif; overflow-wrap: anywhere; }
  .summary { max-width: 760px; margin: 14px 0 0; color: #626c5f; font-size: 14px; line-height: 1.8; }
  .header-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 17px; color: #66745d; font-size: 12px; }
  .header-meta i { width: 3px; height: 3px; background: #8b9a7d; border-radius: 50%; }
  .header-actions { margin-top: 17px; }
  .edit-button { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; color: #355939; background: #edf2e7; border: 1px solid #dbe3d2; border-radius: 5px; font-size: 13px; text-decoration: none; }
  .edit-button svg { width: 14px; fill: none; stroke: currentColor; }
  .reading-layout { padding: 32px 0 40px; }
  .reading-layout.has-outline { display: grid; grid-template-columns: minmax(0, 1fr) 175px; gap: 40px; align-items: start; }
  .article-outline { position: sticky; top: 32px; grid-column: 2; grid-row: 1; padding-left: 18px; border-left: 1px solid #e0e5da; }
  .article-outline > p { margin: 0 0 14px; color: #64725b; font-size: 12px; }
  .article-outline nav { display: flex; flex-direction: column; }
  .article-outline a { padding: 7px 0; color: #5c6a53; font-size: 12px; line-height: 1.7; text-decoration: none; overflow-wrap: anywhere; }
  .article-outline a:hover { color: #365841; text-decoration: underline; }
  .article-outline a.nested { padding-left: 12px; }
  .reading-layout > .prose { grid-column: 1; grid-row: 1; }
  .related { padding: 25px 0; border-top: 1px solid #dfe5d8; }
  .section-label { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .section-label > span { display: none; }
  .section-label h2 { margin: 0; color: #354b30; font-size: 16px; font-weight: 600; }
  .section-label b { color: #66745d; font-size: 12px; font-weight: 400; }
  .related-list a { display: flex; align-items: center; gap: 24px; padding: 18px 0; border-bottom: 1px solid #e5e9df; text-decoration: none; }
  .related-list a > span { flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .related-list small { color: #65745b; font-size: 12px; }
  .related-list strong { color: #354b30; font-size: 15px; font-weight: 600; }
  .related-list em { color: #65745b; font-size: 12px; font-style: normal; }
  .related-list b { color: #5e7752; font-weight: 400; }
  footer { display: flex; justify-content: space-between; width: min(1000px, calc(100% - 112px)); margin: 0 auto; padding: 22px 0 28px; color: #66745d; border-top: 1px solid #e0e5da; font-size: 12px; }
  @media (max-width: 1100px) { main, footer { width: calc(100% - 64px); } .reading-layout.has-outline { gap: 24px; grid-template-columns: minmax(0, 1fr) 155px; } }
  @media (max-width: 900px) { .reading-layout.has-outline { display: flex; flex-direction: column; gap: 24px; } .article-outline { position: static; width: 100%; padding: 16px 18px; background: #f0f3e9; border: 0; border-radius: 6px; } .article-outline nav { display: flex; flex-wrap: wrap; flex-direction: row; gap: 4px 20px; } .reading-layout > .prose { width: 100%; } }
  @media (max-width: 760px) { main, footer { width: calc(100% - 40px); } main { padding-top: 25px; } h1 { font-size: 29px; } .related-list em { display: none; } .back-link { margin-bottom: 20px; } }
</style>
