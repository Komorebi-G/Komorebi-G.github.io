---
import { Code } from "astro:components";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { getCollection, render } from "astro:content";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import { markdownOptions } from "../../lib/markdown-options.mjs";
import { createTagIndex } from "../../lib/tags.mjs";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { formatDate, getExcerpt, getPublishedProblems, type ProblemEntry } from "../../lib/problems";
import { getPublishedTopics, topicRecords } from "../../lib/tag-knowledge";

export async function getStaticPaths() {
  const problems = getPublishedProblems(await getCollection("problems"));
  const topics = getPublishedTopics(await getCollection("tagKnowledge"));
  const statementProcessor = await createMarkdownProcessor(markdownOptions);
  const tagIndex = createTagIndex(topicRecords(topics));

  return Promise.all(problems.map(async (problem, index) => {
    const code = await readFile(join(process.cwd(), "solutions", problem.data.code), "utf8");
    const keys = new Set(problem.data.tags.map((tag) => tagIndex.key(tag)));

    const related = problems
      .filter((candidate) => candidate.id !== problem.id)
      .map((candidate) => ({
        problem: candidate,
        sharedTags: tagIndex.canonical(candidate.data.tags).filter((tag) => keys.has(tagIndex.key(tag))),
      }))
      .filter(({ sharedTags }) => sharedTags.length > 0)
      .sort((a, b) => b.sharedTags.length - a.sharedTags.length)
      .slice(0, 3)
      .map(({ problem, sharedTags }) => ({ ...problem, sharedTags }));

    return {
      params: { id: problem.id },
      props: {
        problem,
        statementHtml: problem.data.statement
          ? (await statementProcessor.render(problem.data.statement)).code
          : "",
        code,
        related,
        topicLinks: Object.fromEntries(problem.data.tags.map((tag) => [
          tag,
          tagIndex.find(tag)?.id ?? "",
        ])),
        previous: problems[index + 1] ?? null,
        next: problems[index - 1] ?? null,
      },
    };
  }));
}

interface Props {
  problem: ProblemEntry;
  statementHtml: string;
  code: string;
  related: (ProblemEntry & { sharedTags: string[] })[];
  topicLinks: Record<string, string>;
  previous: ProblemEntry | null;
  next: ProblemEntry | null;
}

const { problem, statementHtml, code, related, topicLinks, previous, next } = Astro.props;
const { Content } = await render(problem);
const hasStatement = Boolean(problem.data.statement.trim());
const ideaNumber = hasStatement ? "02" : "01";
const solutionNumber = hasStatement ? "03" : "02";
const relatedNumber = hasStatement ? "04" : "03";
const showEditor = import.meta.env.DEV;
---

<BaseLayout
  title={`${problem.data.title} — 题目归档`}
  description={getExcerpt(problem.data.statement) || `${problem.data.title} 的解题思路与代码。`}
  themeColor="#f7f7f4"
>
  <div class="problem-page">
    <Navbar />

    <main id="main-content">
      <a class="back-link" href="/problems" data-return-to-archive>← 返回题目归档</a>

      <header class="problem-header">
        <div class="meta">
          <span>{problem.data.platform}</span>
          <time datetime={problem.data.solvedAt.toISOString()}>{formatDate(problem.data.solvedAt)}</time>
        </div>
        <h1>{problem.data.title}</h1>
        <div class="header-bottom">
          <div class="tags">
            {problem.data.tags.map((tag) => {
              const topicId = topicLinks[tag];
              return (
                <a
                  class:list={{ "has-topic": Boolean(topicId) }}
                  href={topicId ? `/problems/tags/${topicId}` : `/problems?tag=${encodeURIComponent(tag)}`}
                  title={topicId ? `查看「${tag}」标签知识点` : `筛选「${tag}」题目`}
                >
                  {tag}{topicId && <span>↗</span>}
                </a>
              );
            })}
          </div>
          <div class="problem-actions">
            {
              showEditor && (
                <a class="edit-link" href={`/editor/?id=${encodeURIComponent(problem.id)}`}>
                  编辑该题目
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="m10.8 2.7 2.5 2.5M3 13l.7-3.2 7.8-7.8 2.5 2.5-7.8 7.8L3 13Z" />
                  </svg>
                </a>
              )
            }
            <a class="source-link" href={problem.data.url} target="_blank" rel="noreferrer">
              查看原题
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h8v8M13 3 4 12" /></svg>
            </a>
          </div>
        </div>
      </header>

      <nav class="article-shortcuts" aria-label="本页内容">
        {hasStatement && <a href="#statement">题目大意</a>}<a href="#idea">解题思路</a><a href="#solution">代码</a>
      </nav>
      <article class="content-layout">
        {
          hasStatement && (
            <section id="statement" class="statement">
              <div class="section-label"><span>01</span><h2>题目大意</h2></div>
              <div class="prose" set:html={statementHtml} />
            </section>
          )
        }

        <section id="idea" class="idea">
          <div class="section-label"><span>{ideaNumber}</span><h2>思路</h2></div>
          <div class="prose"><Content /></div>
        </section>

        <section id="solution" class="solution">
          <div class="section-label">
            <span>{solutionNumber}</span>
            <h2>代码</h2>
            <button id="copy-code" type="button">
              <span>复制代码</span>
              <svg viewBox="0 0 18 18" aria-hidden="true">
                <rect x="6" y="6" width="9" height="9" rx="1.5" />
                <path d="M12 6V4.5A1.5 1.5 0 0 0 10.5 3h-6A1.5 1.5 0 0 0 3 4.5v6A1.5 1.5 0 0 0 4.5 12H6" />
              </svg>
            </button>
          </div>
          <div class="code-shell">
            <div class="code-bar">
              <span>{problem.data.code}</span>
              <span>{problem.data.language.toUpperCase()}</span>
            </div>
            <div id="code-content"><Code code={code} lang={problem.data.language} theme="github-light" /></div>
          </div>
        </section>
      </article>

      {
        related.length > 0 && (
          <aside class="related">
            <div class="section-label"><span>{relatedNumber}</span><h2>相关题目</h2></div>
            <div class="related-list">
              {related.map((item) => (
                <a href={`/problems/${item.id}`}>
                  <span>{item.data.title}</span>
                  <small>{item.sharedTags.join(" · ")}</small>
                  <b>→</b>
                </a>
              ))}
            </div>
          </aside>
        )
      }

      <nav class="problem-nav" aria-label="题目导航">
        {
          previous ? (
            <a href={`/problems/${previous.id}`}>
              <small>较早</small><span>← {previous.data.title}</span>
            </a>
          ) : <span />
        }
        {
          next && (
            <a class="next" href={`/problems/${next.id}`}>
              <small>较新</small><span>{next.data.title} →</span>
            </a>
          )
        }
      </nav>
    </main>

    <footer><span>LAST UPDATED</span><span>{formatDate(problem.data.updatedAt)}</span></footer>
  </div>

  <script is:inline define:vars={{ rawCode: code }}>
    const copyButton = document.querySelector("#copy-code");
    copyButton?.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(rawCode); }
      catch { const label = copyButton.querySelector("span"); if (label) label.textContent = "复制失败，请手动选择"; return; }
      const label = copyButton.querySelector("span");
      if (!label) return;
      label.textContent = "已复制";
      copyButton.classList.add("copied");
      setTimeout(() => {
        label.textContent = "复制代码";
        copyButton.classList.remove("copied");
      }, 1600);
    });

    const savedArchiveUrl = sessionStorage.getItem("problemArchiveUrl");
    const backLink = document.querySelector("[data-return-to-archive]");
    if (savedArchiveUrl && backLink) backLink.setAttribute("href", savedArchiveUrl);
  </script>
</BaseLayout>

<style>

  main { width: min(900px, calc(100% - 112px)); margin: 0 auto; padding: 40px 0 30px; }
  .back-link { display: inline-block; margin-bottom: 25px; color: #58704e; font-size: 13px; text-decoration: none; }
  .meta { display: flex; gap: 16px; margin-bottom: 15px; color: #64725b; font-size: 12px; }
  h1 { margin: 0; color: #2d432f; font: 500 36px/1.4 "Noto Serif SC", "Songti SC", serif; overflow-wrap: anywhere; }
  .header-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 18px; margin-top: 20px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .tags a { display: flex; align-items: center; gap: 8px; padding: 7px 10px; color: #4f6744; background: #edf2e7; border-radius: 5px; font-size: 12px; text-decoration: none; }
  .problem-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .problem-actions a { display: inline-flex; align-items: center; gap: 7px; padding: 7px 10px; color: #486440; border: 1px solid #dce4d2; border-radius: 5px; font-size: 12px; text-decoration: none; }
  .problem-actions svg { width: 14px; fill: none; stroke: currentColor; }
  .article-shortcuts { display: flex; gap: 24px; margin: 26px 0 30px; padding: 16px 0; border-top: 1px solid #dfe5d8; border-bottom: 1px solid #dfe5d8; }
  .article-shortcuts a { color: #516c47; font-size: 13px; text-decoration: none; }
  .statement, .idea, .solution, .related { margin-bottom: 35px; scroll-margin-top: 25px; }
  .section-label { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
  .section-label > span { color: #73816a; font: 12px/1 "IBM Plex Mono", monospace; }
  .section-label h2 { margin: 0; color: #334c2e; font-size: 18px; font-weight: 600; }
  .section-label button { display: flex; align-items: center; gap: 8px; margin-left: auto; padding: 8px 12px; color: #45623b; background: #edf2e7; border: 1px solid #dce4d2; border-radius: 5px; cursor: pointer; font-size: 12px; }
  .section-label button svg { width: 15px; fill: none; stroke: currentColor; }
  .code-shell { overflow: hidden; background: #fff; border: 1px solid #dce4d2; border-radius: 7px; }
  .code-bar { display: flex; justify-content: space-between; gap: 12px; padding: 13px 17px; color: #607253; background: #f0f4e9; border-bottom: 1px solid #dfe5d8; font: 12px/1.5 "IBM Plex Mono", monospace; }
  #code-content { max-height: 640px; overflow: auto; }
  #code-content :global(pre) { min-width: max-content; margin: 0; padding: 22px; background: #fff !important; font: 13px/1.85 "JetBrains Mono", Consolas, monospace; }
  .related-list a { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 17px 0; border-bottom: 1px solid #e5e9df; text-decoration: none; }
  .related-list span { flex: 1; color: #354b30; font-size: 15px; font-weight: 600; }
  .related-list small { color: #65745b; font-size: 12px; }
  .related-list b { color: #5e7752; font-weight: 400; }
  .problem-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding-top: 22px; border-top: 1px solid #dfe5d8; }
  .problem-nav a { display: flex; flex-direction: column; gap: 10px; min-width: 0; text-decoration: none; }
  .problem-nav a.next { text-align: right; }
  .problem-nav small { color: #66745d; font-size: 12px; }
  .problem-nav span { overflow: hidden; color: #425c36; font-size: 14px; text-overflow: ellipsis; white-space: nowrap; }
  footer { width: min(900px, calc(100% - 112px)); display: flex; justify-content: space-between; margin: 0 auto; padding: 22px 0 28px; color: #66745d; border-top: 1px solid #e0e5da; font-size: 12px; }
  @media (max-width: 1100px) { main, footer { width: calc(100% - 64px); } }
  @media (max-width: 760px) { main, footer { width: calc(100% - 40px); } main { padding-top: 25px; } h1 { font-size: 29px; } .related-list small { max-width: 100px; } .statement, .idea, .solution { scroll-margin-top: 90px; } }
</style>
