---
import { Code } from "astro:components";
import { getCollection, render } from "astro:content";
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { formatDate, getPublishedProblems, type ProblemEntry } from "../../lib/problems";
import { findTopicForTag, getPublishedTopics } from "../../lib/topics";

export async function getStaticPaths() {
  const problems = getPublishedProblems(await getCollection("problems"));
  const topics = getPublishedTopics(await getCollection("topics"));

  return Promise.all(problems.map(async (problem, index) => {
    let code = "";
    try {
      code = await readFile(join(process.cwd(), "solutions", problem.data.code), "utf8");
    } catch {
      code = "// 未找到代码文件";
    }

    const related = problems
      .filter((candidate) => candidate.id !== problem.id)
      .map((candidate) => ({
        problem: candidate,
        score: candidate.data.tags.filter((tag) => problem.data.tags.includes(tag)).length,
      }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 3)
      .map(({ problem }) => problem);

    return {
      params: { id: problem.id },
      props: {
        problem,
        code,
        related,
        topicLinks: Object.fromEntries(problem.data.tags.map((tag) => [
          tag,
          findTopicForTag(topics, tag)?.id ?? "",
        ])),
        previous: problems[index + 1] ?? null,
        next: problems[index - 1] ?? null,
      },
    };
  }));
}

interface Props {
  problem: ProblemEntry;
  code: string;
  related: ProblemEntry[];
  topicLinks: Record<string, string>;
  previous: ProblemEntry | null;
  next: ProblemEntry | null;
}

const { problem, code, related, topicLinks, previous, next } = Astro.props;
const { Content } = await render(problem);
const showEditor = import.meta.env.DEV;
---

<BaseLayout
  title={`${problem.data.title} — 题目归档`}
  description={`${problem.data.title} 的解题思路与代码。`}
  themeColor="#f7f7f4"
>
  <div class="problem-page">
    <Navbar />

    <main>
      <a class="back-link" href="/problems" data-return-to-archive>← 返回题目归档</a>

      <header class="problem-header">
        <div class="meta">
          <span>{problem.data.platform}</span>
          <time datetime={problem.data.solvedAt.toISOString()}>{formatDate(problem.data.solvedAt)}</time>
        </div>
        <h1>{problem.data.title}</h1>
        <div class="header-bottom">
          <div class="tags">
            {problem.data.tags.map((tag) => {
              const topicId = topicLinks[tag];
              return (
                <a
                  class:list={{ "has-topic": Boolean(topicId) }}
                  href={topicId ? `/topics/${topicId}` : `/problems?tag=${encodeURIComponent(tag)}`}
                  title={topicId ? `查看「${tag}」算法笔记` : `筛选「${tag}」题目`}
                >
                  {tag}{topicId && <span>↗</span>}
                </a>
              );
            })}
          </div>
          <div class="problem-actions">
            {
              showEditor && (
                <a class="edit-link" href={`/editor/?id=${encodeURIComponent(problem.id)}`}>
                  编辑该题目
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path d="m10.8 2.7 2.5 2.5M3 13l.7-3.2 7.8-7.8 2.5 2.5-7.8 7.8L3 13Z" />
                  </svg>
                </a>
              )
            }
            <a class="source-link" href={problem.data.url} target="_blank" rel="noreferrer">
              查看原题
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h8v8M13 3 4 12" /></svg>
            </a>
          </div>
        </div>
      </header>

      <article class="content-layout">
        <section class="idea">
          <div class="section-label"><span>01</span><h2>思路</h2></div>
          <div class="prose"><Content /></div>
        </section>

        <section class="solution">
          <div class="section-label">
            <span>02</span>
            <h2>代码</h2>
            <button id="copy-code" type="button">
              <span>复制代码</span>
              <svg viewBox="0 0 18 18" aria-hidden="true">
                <rect x="6" y="6" width="9" height="9" rx="1.5" />
                <path d="M12 6V4.5A1.5 1.5 0 0 0 10.5 3h-6A1.5 1.5 0 0 0 3 4.5v6A1.5 1.5 0 0 0 4.5 12H6" />
              </svg>
            </button>
          </div>
          <div class="code-shell">
            <div class="code-bar">
              <span>{problem.data.code}</span>
              <span>{problem.data.language.toUpperCase()}</span>
            </div>
            <div id="code-content"><Code code={code} lang={problem.data.language} theme="github-light" /></div>
          </div>
        </section>
      </article>

      {
        related.length > 0 && (
          <aside class="related">
            <div class="section-label"><span>03</span><h2>相关题目</h2></div>
            <div class="related-list">
              {related.map((item) => (
                <a href={`/problems/${item.id}`}>
                  <span>{item.data.title}</span>
                  <small>{item.data.tags.filter((tag) => problem.data.tags.includes(tag)).join(" · ")}</small>
                  <b>→</b>
                </a>
              ))}
            </div>
          </aside>
        )
      }

      <nav class="problem-nav" aria-label="题目导航">
        {
          previous ? (
            <a href={`/problems/${previous.id}`}>
              <small>较早</small><span>← {previous.data.title}</span>
            </a>
          ) : <span />
        }
        {
          next && (
            <a class="next" href={`/problems/${next.id}`}>
              <small>较新</small><span>{next.data.title} →</span>
            </a>
          )
        }
      </nav>
    </main>

    <footer><span>LAST UPDATED</span><span>{formatDate(problem.data.updatedAt)}</span></footer>
  </div>

  <script is:inline define:vars={{ rawCode: code }}>
    const copyButton = document.querySelector("#copy-code");
    copyButton?.addEventListener("click", async () => {
      await navigator.clipboard.writeText(rawCode);
      const label = copyButton.querySelector("span");
      if (!label) return;
      label.textContent = "已复制";
      copyButton.classList.add("copied");
      setTimeout(() => {
        label.textContent = "复制代码";
        copyButton.classList.remove("copied");
      }, 1600);
    });

    const savedArchiveUrl = sessionStorage.getItem("problemArchiveUrl");
    const backLink = document.querySelector("[data-return-to-archive]");
    if (savedArchiveUrl && backLink) backLink.setAttribute("href", savedArchiveUrl);
  </script>
</BaseLayout>

<style>
  :global(body) { background: #f7f7f4; color: #23241f; }
  main { width: min(900px, calc(100% - 48px)); margin: 0 auto; padding: 72px 0 120px; }
  .back-link { display: inline-block; margin-bottom: 60px; color: #777971; font-size: 13px; text-decoration: none; }
  .back-link:hover { color: #26372b; }
  .problem-header { padding-bottom: 58px; border-bottom: 1px solid #cecec8; }
  .meta { display: flex; gap: 14px; align-items: center; color: #7f8179; font: 11px/1 "IBM Plex Mono", monospace; text-transform: uppercase; }
  .meta span::after { content: ""; display: inline-block; width: 3px; height: 3px; margin-left: 14px; vertical-align: 2px; background: #a1a29b; border-radius: 50%; }
  h1 { max-width: 820px; margin: 24px 0 34px; font-size: clamp(40px, 6.7vw, 68px); line-height: 1.08; letter-spacing: -.052em; font-weight: 650; text-wrap: balance; }
  .header-bottom { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .tags a { padding: 7px 10px; color: #526359; background: #e9eeea; border-radius: 6px; font-size: 12px; text-decoration: none; }
  .tags a:hover { color: #fff; background: #5c7162; }
  .tags a.has-topic { padding-right: 8px; }
  .tags a span { margin-left: 5px; color: #839087; font: 9px/1 "IBM Plex Mono", monospace; }
  .tags a:hover span { color: #dfe7e1; }
  .problem-actions { display: flex; align-items: center; gap: 18px; }
  .source-link, .edit-link { display: flex; align-items: center; gap: 7px; color: #3c5543; font-size: 13px; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .source-link:hover, .edit-link:hover { color: #789080; }
  .source-link svg, .edit-link svg { width: 15px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  .content-layout { padding-top: 72px; }
  .idea, .solution, .related { margin-bottom: 88px; }
  .section-label { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; }
  .section-label > span { color: #9a9b94; font: 10px/1 "IBM Plex Mono", monospace; }
  .section-label h2 { margin: 0; font-size: 15px; letter-spacing: -.01em; }
  .section-label::after { content: ""; flex: 1; height: 1px; background: #dcddd6; }
  .section-label button { order: 2; display: flex; align-items: center; gap: 7px; padding: 7px 9px; color: #686a62; background: transparent; border: 0; cursor: pointer; font-size: 11px; }
  .section-label button svg { width: 16px; fill: none; stroke: currentColor; stroke-width: 1.3; }
  .section-label button.copied { color: #3f6a4d; }
  .prose { color: #40413c; font: 400 16px/1.95 "Noto Serif SC", serif; }
  .prose :global(h2) { margin: 48px 0 15px; color: #272823; font: 600 24px/1.35 "Space Grotesk", "Noto Serif SC", sans-serif; letter-spacing: -.02em; }
  .prose :global(h3) { margin: 36px 0 12px; color: #30312c; font: 600 19px/1.4 "Space Grotesk", "Noto Serif SC", sans-serif; }
  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(a) { color: #43644c; text-underline-offset: 3px; }
  .prose :global(code) { padding: 2px 5px; color: #35513d; background: #e9ede8; border-radius: 4px; font: .88em/1.5 "IBM Plex Mono", monospace; }
  .prose :global(blockquote) { margin: 30px 0; padding: 4px 0 4px 22px; color: #6b6c65; border-left: 2px solid #91a295; }
  .code-shell { overflow: hidden; background: #fff; border: 1px solid #dadbd4; border-radius: 12px; box-shadow: 0 12px 32px rgba(35,37,31,.045); }
  .code-bar { display: flex; justify-content: space-between; padding: 13px 17px; color: #85877f; background: #f0f1ed; border-bottom: 1px solid #dedfd9; font: 10px/1 "IBM Plex Mono", monospace; }
  #code-content { max-height: 680px; overflow: auto; }
  #code-content :global(pre) { min-width: max-content; margin: 0 !important; padding: 22px !important; background: #fff !important; font: 12px/1.75 "JetBrains Mono", monospace !important; }
  .related-list { border-top: 1px solid #d4d5ce; }
  .related-list a { display: grid; grid-template-columns: 1fr 1fr 20px; gap: 24px; align-items: center; min-height: 76px; color: inherit; border-bottom: 1px solid #dcddd6; text-decoration: none; }
  .related-list span { font-weight: 600; }
  .related-list small { color: #7b7c75; }
  .related-list b { font-weight: 400; transition: transform .18s; }
  .related-list a:hover b { transform: translateX(4px); }
  .problem-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding-top: 30px; border-top: 1px solid #cecec8; }
  .problem-nav a { display: flex; flex-direction: column; gap: 10px; min-width: 0; text-decoration: none; }
  .problem-nav a.next { text-align: right; }
  .problem-nav small { color: #8b8d85; font-size: 11px; }
  .problem-nav span { overflow: hidden; font-size: 14px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  footer { width: min(1120px, calc(100% - 48px)); margin: 0 auto; padding: 28px 0 36px; display: flex; justify-content: space-between; color: #8b8c85; border-top: 1px solid #deddd8; font: 10px/1 "IBM Plex Mono", monospace; }
  @media (max-width: 680px) {
    main, footer { width: min(100% - 32px, 900px); }
    main { padding: 50px 0 80px; }
    .back-link { margin-bottom: 42px; }
    .problem-header { padding-bottom: 40px; }
    .header-bottom { align-items: flex-start; flex-direction: column; }
    .content-layout { padding-top: 54px; }
    .idea, .solution, .related { margin-bottom: 64px; }
    .related-list a { grid-template-columns: 1fr 20px; gap: 12px; padding: 16px 0; }
    .related-list small { grid-column: 1; grid-row: 2; }
    .related-list b { grid-column: 2; grid-row: 1 / span 2; }
    .problem-nav { gap: 18px; }
  }
</style>
