---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import {
  formatDate,
  formatMonth,
  getExcerpt,
  getPublishedProblems,
  normalizeSearchText,
} from "../../lib/problems";
import { getPublishedTopics, topicRecords } from "../../lib/tag-knowledge";
import { buildTagCatalog, createTagIndex } from "../../lib/tags.mjs";

const problems = getPublishedProblems(await getCollection("problems"));
const topics = getPublishedTopics(await getCollection("tagKnowledge"));
const showEditor = import.meta.env.DEV;
const tagIndex = createTagIndex(topicRecords(topics));
const tags = buildTagCatalog(problems.map((problem) => problem.data), topicRecords(topics)).filter((tag) => tag.count > 0);

const groups = new Map<string, typeof problems>();
for (const problem of problems) {
  const key = formatMonth(problem.data.solvedAt);
  const group = groups.get(key) ?? [];
  group.push(problem);
  groups.set(key, group);
}
---

<BaseLayout
  title="题目归档 — LBH"
  description="按标签与时间整理的 ICPC 题目、思路和代码。"
  themeColor="#f7f7f4"
>
  <div class="archive-page">
    <Navbar />

    <main id="main-content">
      <header class="page-header">
        <p class="eyebrow">ICPC / PROBLEM ARCHIVE</p>
        <div class="title-row">
          <div>
            <h1>题目归档</h1>
            <p>题目、解题思路与代码，按标签和时间查找。</p>
          </div>
          <div class="archive-actions">
            <a class="knowledge-link" href="/knowledge">知识点 →</a>
            <span class="total">{problems.length.toString().padStart(2, "0")} 题</span>
            <a class="handbook-link" href="/downloads/icpc-contest-handbook.pdf" download>
              ↓ 赛前速查册
            </a>
            {
              showEditor && (
                <a class="editor-link" href="/editor/">
                  <span>＋</span> 录入题目
                </a>
              )
            }
          </div>
        </div>
      </header>

      {
        (problems.length > 0 || topics.length > 0) ? (
          <>
            <section class="controls" aria-label="检索与筛选">
              <div class="search-wrap">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="6.5" />
                  <path d="m16 16 4 4" />
                </svg>
                <input
                  id="problem-search"
                  type="search"
                  placeholder="搜索题目、标签或思路"
                  autocomplete="off"
                  aria-label="搜索题目"
                />
                <kbd>/</kbd>
              </div>

              <div class="filter-line">
                <div class="tag-list" aria-label="按标签筛选">
                  {tags.map(({ name: tag, count, aliases }) => {
                    return (
                      <span class="tag-option">
                        <button
                          class="tag-filter"
                          type="button"
                          data-tag={tag}
                          data-match-names={JSON.stringify(
                            [tag, ...aliases],
                          )}
                          aria-pressed="false"
                        >
                          {tag}<span>{count}</span>
                        </button>

                      </span>
                    );
                  })}
                </div>
                <button id="sort-toggle" class="sort-toggle" type="button" data-order="desc">
                  <span>最新优先</span>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v12M4.5 10.5 8 14l3.5-3.5" /></svg>
                </button>
              </div>

              <div id="active-state" class="active-state" hidden>
                <span id="result-count" aria-live="polite" />
                <button id="clear-filters" type="button">清除筛选</button>
              </div>
            </section>

            <section id="archive-list" class="archive-list" aria-label="题目列表">
              {[...groups.entries()].map(([month, entries]) => (
                <section class="month-group" data-month={entries[0].data.solvedAt.getTime()}>
                  <h2>{month}</h2>
                  <div class="month-entries">
                    {entries.map((problem) => (
                      <article
                        class="problem-row"
                        data-tags={JSON.stringify(tagIndex.canonical(problem.data.tags))}
                        data-search={normalizeSearchText(
                          [
                            problem.data.title,
                            problem.data.platform,
                            ...problem.data.tags,
                            ...problem.data.tags.flatMap((tag) => {
                              const topic = tagIndex.find(tag);
                              return topic ? [topic.title, ...(topic.aliases || [])] : [];
                            }),
                            problem.data.statement,
                            problem.body ?? "",
                          ].join(" "),
                        )}
                        data-time={problem.data.solvedAt.getTime()}
                      >
                        <time datetime={problem.data.solvedAt.toISOString()}>
                          {formatDate(problem.data.solvedAt).slice(5)}
                        </time>
                        <a class="problem-main" href={`/problems/${problem.id}`}>
                          <strong>{problem.data.title}</strong>
                          <span>
                            {problem.data.platform}
                            {getExcerpt(problem.data.statement || problem.body || "") && (
                              <> · {getExcerpt(problem.data.statement || problem.body || "")}</>
                            )}
                          </span>
                        </a>
                        <div class="row-tags">
                          {problem.data.tags.map((tag) => (
                            <button type="button" class="inline-tag" data-select-tag={tag}>{tag}</button>
                          ))}
                        </div>
                        <a class="row-arrow" href={`/problems/${problem.id}`} aria-label={`查看 ${problem.data.title}`}>
                          →
                        </a>
                      </article>
                    ))}
                  </div>
                </section>
              ))}
            </section>

            <div id="no-results" class="no-results" hidden>
              <strong>没有找到匹配的题目</strong>
              <p>换一个关键词，或者减少已选择的标签。</p>
              <button type="button" data-clear-all>清除筛选</button>
            </div>
          </>
        ) : (
          <section class="empty-archive">
            <span>01</span>
            <h2>从第一道题开始。</h2>
            <p>题目归档目前还是空的。在本地运行编辑器，录入题目、思路和代码。</p>
            <code>npm run problem:edit</code>
          </section>
        )
      }
    </main>

    <footer><span>PROBLEM ARCHIVE</span><span>{problems.length} entries</span></footer>
  </div>

  <script>
    import { normalizeName as normalize } from "../../lib/tags.mjs";
    const search = document.querySelector<HTMLInputElement>("#problem-search");
    const rows = [...document.querySelectorAll<HTMLElement>(".problem-row")];
    const groups = [...document.querySelectorAll<HTMLElement>(".month-group")];
    const archive = document.querySelector<HTMLElement>("#archive-list");
    const tagButtons = [...document.querySelectorAll<HTMLButtonElement>(".tag-filter")];
    const tagMatchNames = new Map(tagButtons.map((button) => [
      button.dataset.tag ?? "",
      JSON.parse(button.dataset.matchNames ?? "[]") as string[],
    ]));
    const activeState = document.querySelector<HTMLElement>("#active-state");
    const resultCount = document.querySelector<HTMLElement>("#result-count");
    const clearButton = document.querySelector<HTMLButtonElement>("#clear-filters");
    const noResults = document.querySelector<HTMLElement>("#no-results");
    const sortButton = document.querySelector<HTMLButtonElement>("#sort-toggle");
    const selectedTags = new Set<string>();

    function syncUrl() {
      const params = new URLSearchParams();
      if (search?.value.trim()) params.set("q", search.value.trim());
      for (const tag of selectedTags) params.append("tag", tag);
      if (sortButton?.dataset.order === "asc") params.set("order", "asc");
      const query = params.toString();
      history.replaceState(null, "", `${location.pathname}${query ? `?${query}` : ""}`);
    }

    function applyFilters() {
      const query = normalize(search?.value ?? "");
      let visible = 0;

      for (const row of rows) {
        const tags: string[] = JSON.parse(row.dataset.tags ?? "[]");
        const matchesQuery = !query || (row.dataset.search ?? "").includes(query);
        const matchesTags = [...selectedTags].every((selectedTag) =>
          (tagMatchNames.get(selectedTag) ?? [selectedTag]).some((matchName) =>
            tags.some((rowTag) => normalize(rowTag) === normalize(matchName))
          )
        );
        const show = matchesQuery && matchesTags;
        row.hidden = !show;
        if (show) visible += 1;
      }

      for (const group of groups) {
        group.hidden = !group.querySelector(".problem-row:not([hidden])");
      }

      const filtering = Boolean(query || selectedTags.size);
      if (activeState) activeState.hidden = !filtering;
      if (resultCount) resultCount.textContent = `找到 ${visible} 道题`;
      if (noResults) noResults.hidden = visible !== 0;
      if (archive) archive.hidden = visible === 0;
      syncUrl();
    }

    function setTag(tag: string, enabled = !selectedTags.has(tag)) {
      tag = [...tagMatchNames].find(([, names]) => names.some((name) => normalize(name) === normalize(tag)))?.[0] ?? tag;
      if (enabled) selectedTags.add(tag);
      else selectedTags.delete(tag);
      for (const button of tagButtons) {
        if (button.dataset.tag === tag) button.setAttribute("aria-pressed", String(enabled));
      }
      applyFilters();
    }

    function clearFilters() {
      selectedTags.clear();
      if (search) search.value = "";
      for (const button of tagButtons) button.setAttribute("aria-pressed", "false");
      applyFilters();
      search?.focus();
    }

    search?.addEventListener("input", applyFilters);
    tagButtons.forEach((button) => {
      button.addEventListener("click", () => setTag(button.dataset.tag ?? ""));
    });
    document.querySelectorAll<HTMLButtonElement>("[data-select-tag]").forEach((button) => {
      button.addEventListener("click", () => {
        setTag(button.dataset.selectTag ?? "", true);
        document.querySelector(".controls")?.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });
    clearButton?.addEventListener("click", clearFilters);
    document.querySelector("[data-clear-all]")?.addEventListener("click", clearFilters);

    sortButton?.addEventListener("click", () => {
      const ascending = sortButton.dataset.order !== "asc";
      sortButton.dataset.order = ascending ? "asc" : "desc";
      const label = sortButton.querySelector("span");
      if (label) label.textContent = ascending ? "最早优先" : "最新优先";
      const orderedGroups = [...groups].sort((a, b) => {
        const diff = Number(a.dataset.month) - Number(b.dataset.month);
        return ascending ? diff : -diff;
      });
      for (const group of orderedGroups) {
        const entries = [...group.querySelectorAll<HTMLElement>(".problem-row")].sort((a, b) => {
          const diff = Number(a.dataset.time) - Number(b.dataset.time);
          return ascending ? diff : -diff;
        });
        group.querySelector(".month-entries")?.append(...entries);
      }
      archive?.append(...orderedGroups);
      applyFilters();
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement;
      if (event.key === "/" && !["INPUT", "TEXTAREA"].includes(target.tagName)) {
        event.preventDefault();
        search?.focus();
      }
      if (event.key === "Escape" && document.activeElement === search) clearFilters();
    });

    document.querySelectorAll<HTMLAnchorElement>(".problem-main, .row-arrow").forEach((link) => {
      link.addEventListener("click", () => {
        sessionStorage.setItem("problemArchiveUrl", `${location.pathname}${location.search}`);
        sessionStorage.setItem("problemArchiveScroll", String(window.scrollY));
      });
    });

    const initial = new URLSearchParams(location.search);
    if (search) search.value = initial.get("q") ?? "";
    for (const tag of initial.getAll("tag")) setTag(tag, true);
    if (initial.get("order") === "asc") sortButton?.click();
    else applyFilters();
    const savedScroll = Number(sessionStorage.getItem("problemArchiveScroll") || "0");
    if (savedScroll) requestAnimationFrame(() => window.scrollTo(0, savedScroll));
  </script>
</BaseLayout>

<style>

  main { width: min(1040px, calc(100% - 112px)); margin: 0 auto; padding: 45px 0 28px; }
  .eyebrow { margin: 0 0 25px; color: #64725b; font: 12px/1.4 "IBM Plex Mono", monospace; letter-spacing: .04em; }
  .page-header { padding-bottom: 30px; }
  .title-row { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  h1 { margin: 0; color: #2d432f; font: 500 36px/1.4 "Noto Serif SC", "Songti SC", serif; }
  .title-row p { margin: 14px 0 0; color: #626c5f; font-size: 14px; line-height: 1.8; }
  .archive-actions { display: flex; align-items: center; gap: 14px; }
  .total { color: #66745d; font: 12px/1.5 "IBM Plex Mono", monospace; white-space: nowrap; }
  .knowledge-link { color: #4e6a42; font-size: 13px; text-decoration: none; white-space: nowrap; }
  .handbook-link { display: none; }
  .editor-link { padding: 11px 17px; color: #fff; background: #365841; border-radius: 6px; font-size: 13px; text-decoration: none; white-space: nowrap; }
  .controls { position: sticky; top: 0; z-index: 10; margin-bottom: 22px; padding: 12px 0 18px; background: #fafbf7; border-bottom: 1px solid #dfe5d8; }
  .search-wrap { position: relative; display: flex; align-items: center; }
  .search-wrap svg { position: absolute; left: 16px; width: 18px; fill: none; stroke: #65725d; stroke-width: 1.5; }
  .search-wrap input { width: 100%; height: 48px; padding: 0 50px 0 46px; color: #293329; background: #fff; border: 1px solid #dbe1d4; border-radius: 7px; font-size: 14px; }
  .search-wrap kbd { position: absolute; right: 15px; padding: 3px 7px; color: #677361; background: #f3f5ef; border: 1px solid #e2e6db; border-radius: 4px; font: 12px/1.2 monospace; }
  .filter-line { display: flex; align-items: flex-start; justify-content: space-between; gap: 18px; margin-top: 14px; }
  .tag-list { display: flex; flex-wrap: wrap; gap: 8px; }
  .tag-option { display: inline-flex; }
  button { cursor: pointer; }
  .tag-filter { padding: 7px 10px; color: #53674c; background: #eef2e8; border: 1px solid transparent; border-radius: 5px; font-size: 12px; }
  .tag-filter span { margin-left: 7px; color: #65765c; font: 12px/1 "IBM Plex Mono", monospace; }
  .tag-filter:hover { border-color: #bac9ad; }
  .tag-filter[aria-pressed="true"] { color: #fff; background: #365841; }
  .tag-filter[aria-pressed="true"] span { color: #e2ecdf; }
  .sort-toggle { display: flex; align-items: center; gap: 7px; flex-shrink: 0; padding: 7px 0; color: #606e58; background: transparent; border: 0; font-size: 12px; }
  .sort-toggle svg { width: 14px; fill: none; stroke: currentColor; }
  .sort-toggle[data-order="asc"] svg { transform: rotate(180deg); }
  .active-state { display: flex; justify-content: space-between; margin-top: 15px; color: #526b46; font-size: 13px; }
  .active-state button, .no-results button { padding: 0; color: #3c633b; background: transparent; border: 0; font-weight: 600; }
  .month-group { display: grid; grid-template-columns: 105px minmax(0, 1fr); }
  .month-group h2 { margin: 0; padding-top: 22px; color: #626f59; font-size: 12px; font-weight: 400; }
  .problem-row { display: grid; grid-template-columns: 46px minmax(0, 1fr) auto 16px; gap: 17px; align-items: center; min-height: 87px; padding: 19px 0; border-bottom: 1px solid #e5e9df; }
  .problem-row time { color: #65745b; font: 12px/1.5 "IBM Plex Mono", monospace; }
  .problem-main { min-width: 0; text-decoration: none; }
  .problem-main strong { display: block; overflow: hidden; color: #31442f; font-size: 16px; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
  .problem-main span { display: -webkit-box; overflow: hidden; margin-top: 8px; color: #66735d; font-size: 12px; line-height: 1.7; -webkit-line-clamp: 1; -webkit-box-orient: vertical; }
  .row-tags { display: flex; flex-wrap: wrap; justify-content: flex-end; max-width: 170px; gap: 6px; }
  .inline-tag { padding: 5px 8px; color: #53674c; background: #edf2e7; border: 0; border-radius: 4px; font-size: 12px; }
  .row-arrow { color: #647958; text-decoration: none; }
  .problem-main:hover strong { color: #527b3e; }
  .no-results { padding: 50px 0; color: #526b46; text-align: center; }
  .no-results strong { font-size: 18px; }
  .no-results p { margin: 14px 0 20px; color: #626c5f; font-size: 14px; }
  .empty-archive { padding: 30px 0; }
  .empty-archive > span { display: none; }
  .empty-archive h2 { color: #354c31; font-size: 22px; }
  .empty-archive p { color: #626c5f; font-size: 14px; }
  .empty-archive code { display: inline-block; padding: 10px; background: #eef2e8; }
  footer { width: min(1040px, calc(100% - 112px)); display: flex; justify-content: space-between; margin: 25px auto 0; padding: 22px 0 28px; color: #66745d; border-top: 1px solid #e0e5da; font-size: 12px; }
  @media (max-width: 1100px) { main, footer { width: calc(100% - 64px); } .month-group { grid-template-columns: 90px minmax(0, 1fr); } .row-tags { max-width: 120px; } .knowledge-link { display: none; } }
  @media (max-width: 900px) { .month-group { display: block; } .month-group h2 { padding-bottom: 10px; } }
  @media (max-width: 760px) { main, footer { width: calc(100% - 40px); } main { padding-top: 28px; } h1 { font-size: 30px; } .title-row { align-items: flex-start; flex-direction: column; gap: 18px; } .controls { top: 69px; } .filter-line { flex-direction: column; gap: 8px; } .sort-toggle { align-self: flex-end; } .problem-row { grid-template-columns: 41px minmax(0, 1fr) 16px; gap: 12px; } .row-tags { grid-column: 2; max-width: none; justify-content: flex-start; } .row-arrow { grid-column: 3; grid-row: 1 / span 2; } .problem-row time { align-self: start; padding-top: 2px; } .title-row p { margin-top: 10px; } }
</style>
