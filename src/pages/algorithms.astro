---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import { demos } from "../data/demos.mjs";
---

<BaseLayout
  title="算法课程演示 — LBH"
  description="算法设计课程的五个交互式实验演示。"
  themeColor="#f7f7f4"
>
  <div class="page">
    <Navbar />
    <main id="main-content">
      <header class="page-header">
        <p class="eyebrow">PROJECTS / 课程项目</p>
        <h1>算法课程演示</h1>
        <p>将算法的执行轨迹做成可暂停、回放和比较的交互页面。</p>
      </header>

      <section class="demo-list" aria-label="课程演示列表">
        {demos.map((demo) => (
          <a class="demo" href={demo.href}>
            <span class="index">{demo.index}</span>
            <span class="name">
              <strong>{demo.title}</strong>
              <small>{demo.english}</small>
            </span>
            <span class="description">{demo.description}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </section>


    </main>

    <footer><span>Algorithm Design & Analysis</span><span>{demos.length} demonstrations</span></footer>
  </div>
</BaseLayout>

<style>

  main { width: min(1040px, calc(100% - 112px)); margin: 0 auto; padding: 45px 0 50px; }
  .eyebrow { margin: 0 0 25px; color: #64725b; font: 12px/1.4 "IBM Plex Mono", monospace; letter-spacing: .04em; }
  h1 { margin: 0; color: #2d432f; font: 500 36px/1.4 "Noto Serif SC", "Songti SC", serif; }
  .page-header p:not(.eyebrow) { margin: 14px 0 0; color: #626c5f; font-size: 14px; line-height: 1.8; }
  .page-header { padding-bottom: 32px; }
  .demo-list { border-top: 1px solid #dfe5d8; }
  .demo { display: grid; grid-template-columns: 30px 1fr 1.3fr 20px; gap: 22px; align-items: center; padding: 27px 0; color: inherit; border-bottom: 1px solid #e5e9df; text-decoration: none; }
  .index { color: #6c7c60; font: 12px/1.5 "IBM Plex Mono", monospace; }
  .name { display: flex; flex-direction: column; gap: 9px; }
  .name strong { color: #32492e; font-size: 19px; font-weight: 600; }
  .name small { color: #637558; font: 12px/1.5 "IBM Plex Mono", monospace; }
  .description { color: #626c5f; font-size: 14px; line-height: 1.8; }
  .arrow { color: #56734b; }
  .demo:hover strong { color: #527b3e; }
  footer { width: min(1040px, calc(100% - 112px)); display: flex; justify-content: space-between; margin: 0 auto; padding: 22px 0 28px; color: #66745d; border-top: 1px solid #e0e5da; font-size: 12px; }
  @media (max-width: 1100px) { main, footer { width: calc(100% - 64px); } }
  @media (max-width: 900px) { .demo { grid-template-columns: 25px 1fr 20px; gap: 15px; } .description { grid-column: 2; grid-row: 2; } .arrow { grid-column: 3; grid-row: 1 / span 2; } }
  @media (max-width: 760px) { main, footer { width: calc(100% - 40px); } main { padding-top: 28px; } h1 { font-size: 30px; } }
</style>
