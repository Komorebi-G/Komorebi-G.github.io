---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import "../styles/training.css";
import {
  regionalRounds,
  trainingBankMeta,
  trainingModes,
} from "../data/training-bank.mjs";
import { codeforcesProblemIdFromUrl } from "../lib/training-engine.mjs";

const archivedIds = (await getCollection("problems"))
  .filter((problem) => !problem.data.draft)
  .map((problem) => codeforcesProblemIdFromUrl(problem.data.url))
  .filter((id): id is string => Boolean(id));
---

<BaseLayout
  title="限时训练 — LBH"
  description="基于真实 ICPC 与 CCPC 区域赛榜单的铜牌关键题和银牌差异题专项训练。"
  themeColor="#fafbf7"
>
  <div class="training-page">
    <Navbar />

    <main id="main-content" data-archived-ids={JSON.stringify(archivedIds)}>
      <header class="hero">
        <div class="hero-copy">
          <p class="eyebrow">PRACTICE / 区域赛练习</p>
          <h1>限时训练</h1>
          <p class="hero-summary">
            从区域赛题库选择单题或两题练习，记录用时、完成情况与待补题。
          </p>
        </div>

      </header>

      <section id="setup-view" class="setup-view" hidden>
        <section id="resume-card" class="resume-card" hidden aria-labelledby="resume-title">
          <div><h2 id="resume-title">有一场未结束的训练</h2><p id="resume-detail"></p></div>
          <div><button id="continue-session" type="button">继续训练 →</button><button id="finish-saved-session" type="button">结束并复盘</button></div>
        </section>
        <section class="upsolve-section" aria-labelledby="upsolve-title">
          <div class="section-title compact"><h2 id="upsolve-title">待补题</h2><p id="pending-count" aria-live="polite"></p></div>
          <div id="upsolve-list"></div>
        </section>
        <div class="section-title recommendation-heading">
          <div>
            <span>01 / START</span>
            <h2 id="recommendation-title">选择训练模式</h2>
            <p id="recommendation-detail">根据可用时间选择，开始后可以暂停或稍后继续。</p>
          </div>
          <div class="local-note"><i></i> 记录保存在当前浏览器</div>
        </div>

        <div class="mode-grid">
          {trainingModes.map((mode) => (
            <article class="mode-card" data-mode-card={mode.id}>
              <div class="mode-top">
                <span>{mode.kicker}</span>
                <b data-recommended-badge hidden>推荐</b>
              </div>
              <h3>{mode.name}</h3>
              <p>{mode.description}</p>
              <dl>
                <div><dt>时长</dt><dd>{mode.durationMinutes} min</dd></div>
                <div><dt>目标</dt><dd>{mode.roles.length} problem{mode.roles.length > 1 ? "s" : ""}</dd></div>
              </dl>
              <button type="button" data-start-mode={mode.id}>开始练习<span>→</span></button>
            </article>
          ))}
        </div>

        <details class="role-map"><summary>选题说明与协作方式</summary>
          <div class="role-intro">
            <span>02 / YOUR JOB</span>
            <h2 id="role-title">训练对象与协作方式</h2>
          </div>
          <ol>
            <li><b>01</b><div><strong>铜牌关键题</strong><p>不默认已经稳定，训练接题、实现和调试。</p></div></li>
            <li><b>02</b><div><strong>银牌差异题</strong><p>训练银牌段通过率明显高于铜牌段的题。</p></div></li>
            <li><b>03</b><div><strong>协作方式</strong><p>队友可参与分析、验证思路和查错，代码由你完成。</p></div></li>
          </ol>
        </details>

        <section class="bank-section" aria-labelledby="bank-title">
          <div class="section-title compact">
            <div>
              <span>03 / REAL PROBLEM BANK</span>
              <h2 id="bank-title">题库与榜单依据 <small>{regionalRounds.length} 场区域赛</small></h2>
            </div>
            <p>过题率均按正式队复算，直接点题号可打开原题</p>
          </div>
          <div class="bank-head" aria-hidden="true"><span>赛站 / 奖牌线</span><span>铜牌关键题</span><span>银牌差异题</span><span>榜单</span></div>
          <div class="bank-list">
            {regionalRounds.map((round) => (
              <article class="bank-row">
                <div class="bank-contest">
                  <strong>{round.name}</strong>
                  <small>
                    {round.officialTeams} 支正式队 · 铜 {round.medalLine.bronze} / 银 {round.medalLine.silver} 题
                    {round.medalLine.penaltyDecides ? " · 同题数看罚时" : ""}
                  </small>
                </div>
                <a class="target-link bronze" href={round.bronze.url} target="_blank" rel="noreferrer">
                  <b>{round.bronze.index}</b><span>铜牌段 {round.bronze.solveRates.bronze}%</span>
                </a>
                <a class="target-link silver" href={round.silver.url} target="_blank" rel="noreferrer">
                  <b>{round.silver.index}</b><span>铜 {round.silver.solveRates.bronze}% → 银 {round.silver.solveRates.silver}%</span>
                </a>
                <a class="board-link" href={round.scoreboardUrl} target="_blank" rel="noreferrer">榜单 ↗</a>
              </article>
            ))}
          </div>
        </section>



        <section class="history-section" aria-labelledby="history-title">
          <div class="section-title compact">
            <div><span>05 / HISTORY</span><h2 id="history-title">最近训练</h2></div>
            <p><b id="solved-total">0</b> 道已通过 · <b id="seen-total">0</b> 道已接触</p>
          </div>
          <div id="history-list" class="history-list"></div>
        </section>
      </section>

      <section id="session-view" class="session-view" hidden aria-labelledby="session-title">
        <header class="session-header">
          <div>
            <p id="session-kicker">REAL CONTEST TARGET</p>
            <h2 id="session-title">铜银连续测试</h2>
            <span id="session-progress">0 / 2 AC</span>
          </div>
          <div class="timer-wrap">
            <small id="timer-label">剩余时间</small>
            <time id="session-timer" aria-live="off">04:00:00</time>
            <button id="pause-session" type="button">暂停</button>
          </div>
        </header>

        <div class="contest-note">
          <div><strong id="contest-name">2024 区域赛</strong><p id="contest-line">正式队榜单推导目标</p></div>
          <span id="session-save-state">已自动保存</span>
        </div>
        <p class="session-rule">队友可参与讨论和查错，代码由你完成。打开题目后自动记为进行中。</p>
        <div id="session-problems" class="session-problems"></div>

        <footer class="session-actions">
          <button id="save-exit-session" class="text-button" type="button">暂停，稍后继续</button>
          <button id="abandon-session" class="text-button" type="button">放弃本轮</button>
          <button id="finish-session" class="finish-button" type="button">结束并复盘 <span>→</span></button>
        </footer>
      </section>

      <section id="review-view" class="review-view" hidden aria-labelledby="review-title">
        <header class="review-header">
          <p>SESSION REVIEW</p>
          <div class="review-score"><strong id="review-score">0 / 2</strong><span>本轮 AC</span></div>
          <div class="review-conclusion"><h2 id="review-title">本轮结束</h2><p id="review-detail"></p></div>
        </header>

        <div class="review-grid">
          <section class="review-focus">
            <span>这轮说明什么</span>
            <h3 id="review-focus">先补完本轮未过题</h3>
            <p>这里只记录完成情况。未通过的题在复盘后独立复现。</p>
          </section>
          <section class="review-next">
            <span>下一步</span>
            <h3 id="review-next-title">先处理当前题</h3>
            <p id="review-next-detail"></p>
            <button id="start-next" type="button">继续 <b>→</b></button>
          </section>
        </div>

        <div class="review-problems-wrap">
          <div class="section-title compact">
            <div><span>SCOREBOARD CONTEXT</span><h2>本轮题目</h2></div>
            <p>交卷后才显示铜牌段与银牌段通过率</p>
          </div>
          <div id="review-problems" class="review-problems"></div>
        </div>
        <button id="close-review" class="back-dashboard" type="button">← 回到训练首页</button>
      </section>

      <aside class="method-note">
        <strong>“铜牌题 / 银牌题”怎么来的？</strong>
        <p>{trainingBankMeta.methodology} 铜牌目标取该场铜牌队常见题集中相对靠后的题；银牌目标取银牌段通过率明显高于铜牌段的题。CF rating 题池只用于算法补弱，不映射奖牌。</p>
        <a href="https://xcpcio.com/guide/data-format" target="_blank" rel="noreferrer">数据格式与来源 ↗</a>
      </aside>
    </main>

    <footer class="page-footer"><span>REAL CONTEST TRAINING</span><span>{trainingBankMeta.updatedAt}</span></footer>
  </div>

  <script>
    import { regionalRounds, trainingBank, trainingModes } from "../data/training-bank.mjs";
    import { elapsedMilliseconds, generateRegionalTest, getPendingProblemIds, recommendNext, summarizeSession } from "../lib/training-engine.mjs";

    type ProblemStatus = "pending" | "attempted" | "solved";
    type Session = {
      id: string;
      modeId: string;
      roundId: string;
      problemIds: string[];
      statuses: Record<string, ProblemStatus>;
      startedAt: number;
      durationMinutes: number;
      totalPausedMs: number;
      pausedAt?: number | null;
      submittedAt?: number;
    };
    type ProgressEntry = { status: "seen" | "solved"; updatedAt: number; source?: string };
    type TrainingState = { active: Session | null; history: Session[]; progress: Record<string, ProgressEntry> };

    const STORAGE_KEY = "lbh.icpc-training.v2";
    const app = document.querySelector<HTMLElement>("#main-content");
    const setupView = document.querySelector<HTMLElement>("#setup-view");
    const sessionView = document.querySelector<HTMLElement>("#session-view");
    const reviewView = document.querySelector<HTMLElement>("#review-view");
    const problemById = new Map(trainingBank.map((problem) => [problem.id, problem]));
    const modeById = new Map(trainingModes.map((mode) => [mode.id, mode]));
    const roundById = new Map(regionalRounds.map((round) => [round.id, round]));
    const roleLabels = { bronze: "铜牌关键题", silver: "银牌差异题" } as const;
    let timerHandle = 0;

    function loadState(): TrainingState {
      try {
        const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "null");
        if (parsed && Array.isArray(parsed.history) && parsed.progress && typeof parsed.progress === "object") {
          return { active: parsed.active ?? null, history: parsed.history, progress: parsed.progress };
        }
      } catch { /* 从空状态恢复 */ }
      return { active: null, history: [], progress: {} };
    }

    const state = loadState();
    const archivedIds: string[] = JSON.parse(app?.dataset.archivedIds ?? "[]");
    for (const id of archivedIds) {
      if (problemById.has(id)) state.progress[id] = { status: "solved", updatedAt: Date.now(), source: "archive" };
    }

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      const indicator = document.querySelector<HTMLElement>("#session-save-state");
      if (indicator) {
        indicator.textContent = "已自动保存";
        indicator.classList.add("saved-pulse");
        window.setTimeout(() => indicator.classList.remove("saved-pulse"), 500);
      }
    }

    function showOnly(view: HTMLElement | null) {
      for (const candidate of [setupView, sessionView, reviewView]) {
        if (candidate) candidate.hidden = candidate !== view;
      }
      app?.classList.toggle("focus-mode", view !== setupView);
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function formatClock(milliseconds: number) {
      const totalSeconds = Math.floor(Math.abs(milliseconds) / 1000);
      const hours = Math.floor(totalSeconds / 3600);
      const minutes = Math.floor((totalSeconds % 3600) / 60);
      const seconds = totalSeconds % 60;
      return `${hours.toString().padStart(2, "0")}:${minutes.toString().padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`;
    }

    function solvedCount(session: Session) {
      return session.problemIds.filter((id) => session.statuses[id] === "solved").length;
    }

    function updateTimer() {
      const session = state.active;
      const timer = document.querySelector<HTMLTimeElement>("#session-timer");
      const label = document.querySelector<HTMLElement>("#timer-label");
      if (!session || !timer || !label) return;
      const remaining = session.durationMinutes * 60_000 - elapsedMilliseconds(session);
      timer.textContent = `${remaining < 0 ? "+" : ""}${formatClock(remaining)}`;
      timer.classList.toggle("overtime", remaining < 0);
      label.textContent = session.pausedAt ? "计时已暂停" : remaining < 0 ? "已经超时" : "剩余时间";
    }

    function startTimer() {
      window.clearInterval(timerHandle);
      updateTimer();
      timerHandle = window.setInterval(updateTimer, 1_000);
    }

    function statusCopy(status: ProblemStatus) {
      if (status === "solved") return "已 AC";
      if (status === "attempted") return "进行中";
      return "未开始";
    }

    function medalLineCopy(round: (typeof regionalRounds)[number]) {
      const suffix = round.medalLine.penaltyDecides ? "，同题数由罚时决定" : "";
      return `${round.officialTeams} 支正式队 · 铜牌线 ${round.medalLine.bronze} 题 · 银牌线 ${round.medalLine.silver} 题${suffix}`;
    }

    function setProblemStatus(problemId: string, status: ProblemStatus) {
      const session = state.active;
      if (!session) return;
      session.statuses[problemId] = status;
      if (status !== "pending") {
        const existing = state.progress[problemId];
        state.progress[problemId] = {
          status: status === "solved" || existing?.status === "solved" ? "solved" : "seen",
          updatedAt: Date.now(),
          source: existing?.source,
        };
      }
      saveState();
      renderSession();
    }

    function renderSession() {
      const session = state.active;
      if (!session) return;
      const mode = modeById.get(session.modeId);
      const round = roundById.get(session.roundId);
      const title = document.querySelector<HTMLElement>("#session-title");
      const kicker = document.querySelector<HTMLElement>("#session-kicker");
      const progress = document.querySelector<HTMLElement>("#session-progress");
      const pauseButton = document.querySelector<HTMLButtonElement>("#pause-session");
      const contestName = document.querySelector<HTMLElement>("#contest-name");
      const contestLine = document.querySelector<HTMLElement>("#contest-line");
      const list = document.querySelector<HTMLElement>("#session-problems");
      if (title) title.textContent = mode?.name ?? "真赛专项";
      if (kicker) kicker.textContent = `${session.problemIds.length} TARGET${session.problemIds.length > 1 ? "S" : ""} / ${session.durationMinutes} MINUTES`;
      if (progress) progress.textContent = `${solvedCount(session)} / ${session.problemIds.length} AC`;
      if (pauseButton) pauseButton.textContent = session.pausedAt ? "继续计时" : "暂停";
      if (contestName) contestName.textContent = round?.name ?? "真实区域赛";
      if (contestLine && round) contestLine.textContent = medalLineCopy(round);
      if (!list) return;
      list.replaceChildren();

      session.problemIds.forEach((id) => {
        const problem = problemById.get(id);
        if (!problem) return;
        const status = session.statuses[id] ?? "pending";
        const row = document.createElement("article");
        row.className = `session-problem status-${status} role-${problem.role}`;

        const marker = document.createElement("span");
        marker.className = "problem-marker";
        marker.textContent = problem.index;

        const copy = document.createElement("div");
        copy.className = "problem-copy";
        const role = document.createElement("small");
        role.textContent = roleLabels[problem.role as keyof typeof roleLabels];
        const name = document.createElement("strong");
        name.textContent = `Problem ${problem.index}`;
        const meta = document.createElement("span");
        meta.textContent = `${problem.platform} · ${statusCopy(status)}`;
        copy.append(role, name, meta);

        const open = document.createElement("a");
        open.href = problem.url;
        open.target = "_blank";
        open.rel = "noreferrer";
        open.textContent = status === "pending" ? "打开原题 ↗" : "返回原题 ↗";
        open.addEventListener("click", () => {
          if ((session.statuses[id] ?? "pending") === "pending") setProblemStatus(id, "attempted");
        });

        const ac = document.createElement("button");
        ac.type = "button";
        ac.className = "ac-button";
        ac.setAttribute("aria-pressed", String(status === "solved"));
        ac.textContent = status === "solved" ? "✓ AC" : "标记 AC";
        ac.addEventListener("click", () => setProblemStatus(id, status === "solved" ? "attempted" : "solved"));
        row.append(marker, copy, open, ac);
        list.append(row);
      });
      startTimer();
    }

    function startMode(modeId: string) {
      if (state.active) { showOnly(sessionView); renderSession(); return; }
      const mode = modeById.get(modeId);
      if (!mode) return;
      const now = Date.now();
      const { round, problems } = generateRegionalTest(regionalRounds, mode, {
        seed: now,
        seenProblemIds: Object.keys(state.progress),
      });
      state.active = {
        id: `${modeId}-${now}`,
        modeId,
        roundId: round.id,
        problemIds: problems.map((problem: (typeof trainingBank)[number]) => problem.id),
        statuses: {},
        startedAt: now,
        durationMinutes: mode.durationMinutes,
        totalPausedMs: 0,
        pausedAt: null,
      };
      saveState();
      showOnly(sessionView);
      renderSession();
    }

    function finishSession() {
      const session = state.active;
      if (!session) return;
      if (!Object.keys(session.statuses).length && !window.confirm("这轮还没有开始，仍然结束吗？")) return;
      const now = Date.now();
      if (session.pausedAt) {
        session.totalPausedMs += now - session.pausedAt;
        session.pausedAt = null;
      }
      session.submittedAt = now;
      const finished = structuredClone(session);
      state.history.unshift(finished);
      state.history = state.history.slice(0, 30);
      state.active = null;
      saveState();
      renderReview(finished);
      showOnly(reviewView);
      window.clearInterval(timerHandle);
    }

    function renderReview(session: Session) {
      const summary = summarizeSession(session, trainingBank);
      const mode = modeById.get(session.modeId);
      const round = roundById.get(session.roundId);
      const recommendation = recommendNext([session, ...state.history.filter((entry) => entry.id !== session.id)]);
      const nextMode = modeById.get(recommendation.modeId);
      const unsolvedId = session.problemIds.find((id) => session.statuses[id] !== "solved" && state.progress[id]?.status !== "solved");
      const unsolved = unsolvedId ? problemById.get(unsolvedId) : null;
      const score = document.querySelector<HTMLElement>("#review-score");
      const title = document.querySelector<HTMLElement>("#review-title");
      const detail = document.querySelector<HTMLElement>("#review-detail");
      const focus = document.querySelector<HTMLElement>("#review-focus");
      const nextTitle = document.querySelector<HTMLElement>("#review-next-title");
      const nextDetail = document.querySelector<HTMLElement>("#review-next-detail");
      const nextButton = document.querySelector<HTMLButtonElement>("#start-next");
      if (score) score.textContent = `${summary.solved} / ${summary.total}`;
      if (title) title.textContent = summary.solved === summary.total ? "本轮全部通过" : `${mode?.name ?? "本轮"}结束`;
      if (detail) detail.textContent = `${round?.name ?? "真实赛站"} · 实际用时 ${formatClock(elapsedMilliseconds(session))} · ${summary.attempted} 题尝试未过，${summary.skipped} 题未开始。`;
      if (focus) {
        const bronze = session.problemIds.find((id) => problemById.get(id)?.role === "bronze");
        focus.textContent = bronze && session.statuses[bronze] !== "solved"
          ? "铜牌关键题未通过"
          : unsolved ? "本轮仍有未通过的题目" : "本轮全部通过";
      }
      if (nextTitle) nextTitle.textContent = unsolved ? `先补 Problem ${unsolved.index}` : nextMode?.name ?? recommendation.title;
      if (nextDetail) nextDetail.textContent = unsolved
        ? "先回到这道题复盘并独立复现，不用立刻开新题。"
        : recommendation.detail;
      if (nextButton) {
        nextButton.textContent = unsolved ? "打开未过题 ↗" : "按建议开下一场 →";
        nextButton.dataset.mode = unsolved ? "" : recommendation.modeId;
        nextButton.dataset.problem = unsolved?.id ?? "";
      }

      const list = document.querySelector<HTMLElement>("#review-problems");
      if (!list) return;
      list.replaceChildren();
      session.problemIds.forEach((id) => {
        const problem = problemById.get(id);
        if (!problem) return;
        const status = session.statuses[id] ?? "pending";
        const row = document.createElement("article");
        row.className = `review-problem review-${status}`;
        const indexNode = document.createElement("span");
        indexNode.textContent = problem.index;
        const copy = document.createElement("div");
        const name = document.createElement("strong");
        name.textContent = roleLabels[problem.role as keyof typeof roleLabels];
        const meta = document.createElement("small");
        meta.textContent = `铜牌段 ${problem.solveRates.bronze}% · 银牌段 ${problem.solveRates.silver}% · ${statusCopy(status)}`;
        copy.append(name, meta);
        const link = document.createElement("a");
        link.href = problem.url;
        link.target = "_blank";
        link.rel = "noreferrer";
        link.textContent = status === "solved" ? "再看原题 ↗" : "去补题 ↗";
        row.append(indexNode, copy, link);
        list.append(row);
      });
    }

    function renderDashboard() {
      const recommendation = recommendNext(state.history);
      const resume = document.querySelector<HTMLElement>("#resume-card");
      if (resume) resume.hidden = !state.active;
      const resumeDetail = document.querySelector("#resume-detail");
      if (resumeDetail && state.active) resumeDetail.textContent = `${modeById.get(state.active.modeId)?.name ?? "区域赛练习"} · ${roundById.get(state.active.roundId)?.name ?? ""} · 已暂停`;
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-start-mode]")) {
        button.disabled = Boolean(state.active);
        button.title = state.active ? "先继续或结束已有训练" : "";
      }
      const pending = getPendingProblemIds(state.history, state.progress).filter((id: string) => problemById.has(id));
      const pendingCount = document.querySelector("#pending-count");
      if (pendingCount) pendingCount.textContent = `${pending.length} 题`;
      const pendingList = document.querySelector("#upsolve-list");
      pendingList?.replaceChildren();
      if (pendingList && !pending.length) {
        const empty = document.createElement("p"); empty.className = "empty-history"; empty.textContent = "暂无待补题。结束训练后，未通过的题目会出现在这里。"; pendingList.append(empty);
      }
      for (const id of pending) {
        const problem = problemById.get(id)!;
        const row = document.createElement("div"); row.className = "upsolve-row";
        const link = document.createElement("a"); link.href = problem.url; link.target = "_blank"; link.rel = "noreferrer"; link.textContent = `${problem.title} ↗`;
        const done = document.createElement("button"); done.type = "button"; done.textContent = "标记已补"; done.setAttribute("aria-label", `标记 ${problem.title} 已补`);
        done.addEventListener("click", () => { state.progress[id] = { status: "solved", updatedAt: Date.now(), source: "upsolve" }; saveState(); renderDashboard(); });
        row.append(link, done); pendingList?.append(row);
      }
      const title = document.querySelector<HTMLElement>("#recommendation-title");
      const detail = document.querySelector<HTMLElement>("#recommendation-detail");
      if (title) title.textContent = state.history.length ? recommendation.title : "选择训练模式";
      if (detail) detail.textContent = state.history.length ? recommendation.detail : "根据可用时间选择，开始后可以暂停或稍后继续。";
      document.querySelectorAll<HTMLElement>("[data-mode-card]").forEach((card) => {
        const recommended = state.history.length > 0 && card.dataset.modeCard === recommendation.modeId;
        card.classList.toggle("recommended", recommended);
        const badge = card.querySelector<HTMLElement>("[data-recommended-badge]");
        if (badge) badge.hidden = !recommended;
      });

      const entries = Object.values(state.progress);
      const solvedTotal = document.querySelector<HTMLElement>("#solved-total");
      const seenTotal = document.querySelector<HTMLElement>("#seen-total");
      if (solvedTotal) solvedTotal.textContent = String(entries.filter((entry) => entry.status === "solved").length);
      if (seenTotal) seenTotal.textContent = String(entries.length);

      const historyList = document.querySelector<HTMLElement>("#history-list");
      if (!historyList) return;
      historyList.replaceChildren();
      if (!state.history.length) {
        const empty = document.createElement("p");
        empty.className = "empty-history";
        empty.textContent = "还没有训练记录。选择一种测试即可开始，不需要填写资料。";
        historyList.append(empty);
        return;
      }
      state.history.slice(0, 6).forEach((session) => {
        const row = document.createElement("article");
        row.className = "history-row";
        const date = document.createElement("time");
        date.textContent = new Intl.DateTimeFormat("zh-CN", { month: "2-digit", day: "2-digit" }).format(session.submittedAt ?? session.startedAt);
        const copy = document.createElement("div");
        const name = document.createElement("strong");
        name.textContent = modeById.get(session.modeId)?.name ?? "真赛专项";
        const meta = document.createElement("span");
        meta.textContent = `${roundById.get(session.roundId)?.name ?? "真实赛站"} · ${formatClock(elapsedMilliseconds(session))}`;
        copy.append(name, meta);
        const result = document.createElement("b");
        result.textContent = `${solvedCount(session)} / ${session.problemIds.length} AC`;
        const review = document.createElement("button"); review.type = "button"; review.textContent = "复盘 →"; review.className = "history-review";
        review.addEventListener("click", () => { renderReview(session); showOnly(reviewView); });
        row.append(date, copy, result, review);
        historyList.append(row);
      });
    }

    document.querySelectorAll<HTMLButtonElement>("[data-start-mode]").forEach((button) => {
      button.addEventListener("click", () => startMode(button.dataset.startMode ?? "medal-run"));
    });
    document.querySelector("#pause-session")?.addEventListener("click", () => {
      const session = state.active;
      if (!session) return;
      const now = Date.now();
      if (session.pausedAt) {
        session.totalPausedMs += now - session.pausedAt;
        session.pausedAt = null;
      } else {
        session.pausedAt = now;
      }
      saveState();
      renderSession();
    });
    document.querySelector("#finish-session")?.addEventListener("click", finishSession);
    document.querySelector("#abandon-session")?.addEventListener("click", () => {
      if (!state.active || !window.confirm("放弃本轮？已经打开过的题仍保留在轮换记录里。")) return;
      state.active = null;
      saveState();
      window.clearInterval(timerHandle);
      renderDashboard();
      showOnly(setupView);
    });
    document.querySelector("#start-next")?.addEventListener("click", (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const problem = problemById.get(button.dataset.problem ?? "");
      if (problem) {
        window.open(problem.url, "_blank", "noopener,noreferrer");
        return;
      }
      startMode(button.dataset.mode ?? "medal-run");
    });
    document.querySelector("#close-review")?.addEventListener("click", () => {
      renderDashboard();
      showOnly(setupView);
    });

    function pauseActive() {
      if (state.active && !state.active.pausedAt) { state.active.pausedAt = Date.now(); saveState(); }
      window.clearInterval(timerHandle);
    }
    document.querySelector("#save-exit-session")?.addEventListener("click", () => { pauseActive(); renderDashboard(); showOnly(setupView); });
    document.querySelector("#continue-session")?.addEventListener("click", () => {
      if (!state.active) return;
      if (state.active.pausedAt) { state.active.totalPausedMs += Date.now() - state.active.pausedAt; state.active.pausedAt = null; }
      saveState(); showOnly(sessionView); renderSession();
    });
    document.querySelector("#finish-saved-session")?.addEventListener("click", finishSession);
    window.addEventListener("pagehide", pauseActive);
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) { renderDashboard(); showOnly(setupView); }
    });
    if (state.active && (!roundById.has(state.active.roundId) || !state.active.problemIds.every((id) => problemById.has(id)))) state.active = null;
    pauseActive();
    saveState();
    renderDashboard();
    showOnly(setupView);
  </script>
</BaseLayout>
