---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { getPublishedProblems, normalizeSearchText } from "../../lib/problems";
import { getProblemsForTopic, getPublishedTopics } from "../../lib/topics";

const topics = getPublishedTopics(await getCollection("topics"));
const problems = getPublishedProblems(await getCollection("problems"));
const groups = new Map<string, typeof topics>();
const showEditor = import.meta.env.DEV;

for (const topic of topics) {
  const entries = groups.get(topic.data.group) ?? [];
  entries.push(topic);
  groups.set(topic.data.group, entries);
}
---

<BaseLayout
  title="算法笔记 — LBH"
  description="按专题整理的算法知识、常见写法、代码模板与相关题目。"
  themeColor="#f3f1eb"
>
  <div class="topics-page">
    <Navbar />

    <main>
      <header class="page-header">
        <p class="eyebrow">ALGORITHM NOTES / KNOWLEDGE BASE</p>
        <h1>算法笔记</h1>
        <p class="lead">从题目中提炼出来，可以反复查阅的知识、写法和模板。</p>
        {
          showEditor && (
            <a class="editor-entry" href="/topic-editor/">
              编辑标签知识点
              <span>→</span>
            </a>
          )
        }
        <div class="summary-line">
          <span>{topics.length.toString().padStart(2, "0")} 个专题</span>
          <i />
          <span>{groups.size.toString().padStart(2, "0")} 个分类</span>
        </div>
      </header>

      {
        topics.length > 0 ? (
          <>
            <section class="topic-controls" aria-label="搜索算法笔记">
              <label class="search-wrap">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="6.5" />
                  <path d="m16 16 4 4" />
                </svg>
                <input
                  id="topic-search"
                  type="search"
                  placeholder="搜索专题、技巧或模板"
                  autocomplete="off"
                />
                <kbd>/</kbd>
              </label>
              <div class="group-filters" aria-label="按分类筛选">
                <button type="button" data-group="" aria-pressed="true">全部</button>
                {[...groups.keys()].map((group) => (
                  <button type="button" data-group={group} aria-pressed="false">{group}</button>
                ))}
              </div>
            </section>

            <div id="topic-groups">
              {[...groups.entries()].map(([group, entries], groupIndex) => (
                <section class="topic-group" data-topic-group={group}>
                  <header>
                    <span>{String(groupIndex + 1).padStart(2, "0")}</span>
                    <h2>{group}</h2>
                    <b>{entries.length}</b>
                  </header>
                  <div class="topic-grid">
                    {entries.map((topic) => {
                      const related = getProblemsForTopic(topic, problems);
                      return (
                        <article
                          class="topic-card"
                          data-group={group}
                          data-search={normalizeSearchText([
                            topic.data.title,
                            topic.data.summary,
                            topic.data.group,
                            ...topic.data.aliases,
                            topic.body ?? "",
                          ].join(" "))}
                        >
                          <a class="card-main" href={`/topics/${topic.id}`}>
                            <span class="card-number">NOTE / {String(topic.data.order).padStart(2, "0")}</span>
                            <h3>{topic.data.title}</h3>
                            <p>{topic.data.summary}</p>
                            <div class="card-meta">
                              <span>{related.length} 道相关题目</span>
                              <b>阅读专题 <i>→</i></b>
                            </div>
                          </a>
                          <a
                            class="pdf-link"
                            href={`/topics/${topic.id}.pdf`}
                            target="_blank"
                            aria-label={`打开 ${topic.data.title} PDF`}
                          >
                            PDF
                          </a>
                        </article>
                      );
                    })}
                  </div>
                </section>
              ))}
            </div>

            <section id="no-topics" class="no-topics" hidden>
              <strong>没有找到匹配的专题</strong>
              <p>换一个关键词，或者查看其他分类。</p>
              <button type="button">清除筛选</button>
            </section>
          </>
        ) : (
          <section class="empty-topics">
            <span>01</span>
            <h2>从第一篇算法笔记开始。</h2>
            <p>在 <code>src/content/topics</code> 中创建 Markdown 文件即可。</p>
          </section>
        )
      }
    </main>

    <footer><span>ALGORITHM NOTES</span><span>Markdown · LaTeX · PDF</span></footer>
  </div>

  <script>
    const search = document.querySelector<HTMLInputElement>("#topic-search");
    const cards = [...document.querySelectorAll<HTMLElement>(".topic-card")];
    const groups = [...document.querySelectorAll<HTMLElement>(".topic-group")];
    const filters = [...document.querySelectorAll<HTMLButtonElement>("[data-group]")];
    const empty = document.querySelector<HTMLElement>("#no-topics");
    let activeGroup = "";

    const normalize = (value: string) => value.toLocaleLowerCase().replace(/\s+/g, "");

    function applyFilters() {
      const query = normalize(search?.value ?? "");
      let visible = 0;

      for (const card of cards) {
        const matchesSearch = !query || (card.dataset.search ?? "").includes(query);
        const matchesGroup = !activeGroup || card.dataset.group === activeGroup;
        card.hidden = !(matchesSearch && matchesGroup);
        if (!card.hidden) visible += 1;
      }

      for (const group of groups) {
        group.hidden = !group.querySelector(".topic-card:not([hidden])");
      }

      if (empty) empty.hidden = visible > 0;
      const params = new URLSearchParams();
      if (search?.value.trim()) params.set("q", search.value.trim());
      if (activeGroup) params.set("group", activeGroup);
      const queryString = params.toString();
      history.replaceState(null, "", `${location.pathname}${queryString ? `?${queryString}` : ""}`);
    }

    function setGroup(group: string) {
      activeGroup = group;
      for (const filter of filters) {
        filter.setAttribute("aria-pressed", String((filter.dataset.group ?? "") === activeGroup));
      }
      applyFilters();
    }

    search?.addEventListener("input", applyFilters);
    filters.forEach((filter) => {
      filter.addEventListener("click", () => setGroup(filter.dataset.group ?? ""));
    });
    empty?.querySelector("button")?.addEventListener("click", () => {
      if (search) search.value = "";
      setGroup("");
      search?.focus();
    });
    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement;
      if (event.key === "/" && !["INPUT", "TEXTAREA"].includes(target.tagName)) {
        event.preventDefault();
        search?.focus();
      }
    });

    const initial = new URLSearchParams(location.search);
    if (search) search.value = initial.get("q") ?? "";
    const requestedGroup = initial.get("group") ?? "";
    setGroup(filters.some((filter) => filter.dataset.group === requestedGroup) ? requestedGroup : "");
  </script>
</BaseLayout>

<style>
  :global(body) { background: #f3f1eb; color: #22241f; }
  .topics-page { min-height: 100vh; }
  main { width: min(1040px, calc(100% - 48px)); margin: 0 auto; padding: 90px 0 120px; }
  .page-header { max-width: 760px; margin: 0 auto 72px; text-align: center; }
  .eyebrow { margin: 0 0 25px; color: #778078; font: 10px/1 "IBM Plex Mono", monospace; letter-spacing: .15em; }
  h1 { margin: 0; font-size: clamp(52px, 8vw, 82px); line-height: 1; letter-spacing: -.06em; font-weight: 650; }
  .lead { max-width: 560px; margin: 25px auto 0; color: #666b64; font: 400 16px/1.9 "Noto Serif SC", serif; }
  .editor-entry { display: inline-flex; align-items: center; gap: 9px; margin-top: 25px; padding: 10px 14px; color: #f8f8f4; background: #536a59; border-radius: 8px; font-size: 12px; font-weight: 600; text-decoration: none; }
  .editor-entry:hover { background: #405647; }
  .editor-entry span { transition: transform .18s; }
  .editor-entry:hover span { transform: translateX(3px); }
  .summary-line { display: flex; align-items: center; justify-content: center; gap: 13px; margin-top: 30px; color: #858a83; font: 10px/1 "IBM Plex Mono", monospace; letter-spacing: .08em; }
  .summary-line i { width: 3px; height: 3px; background: #8d938c; border-radius: 50%; }
  .topic-controls { position: sticky; top: 12px; z-index: 10; margin-bottom: 64px; padding: 14px; background: rgba(243,241,235,.92); border: 1px solid #d9d8d1; border-radius: 16px; box-shadow: 0 14px 38px rgba(39,43,36,.06); backdrop-filter: blur(14px); }
  .search-wrap { position: relative; display: flex; align-items: center; }
  .search-wrap svg { position: absolute; left: 16px; width: 18px; fill: none; stroke: #727870; stroke-width: 1.7; }
  .search-wrap input { width: 100%; height: 50px; padding: 0 52px 0 47px; color: #242720; background: #fff; border: 1px solid #d6d6cf; border-radius: 10px; outline: none; font-size: 15px; }
  .search-wrap input:focus { border-color: #748578; box-shadow: 0 0 0 3px rgba(96,121,101,.12); }
  .search-wrap kbd { position: absolute; right: 14px; display: grid; place-items: center; width: 24px; height: 24px; color: #8a8d86; background: #f2f1ed; border: 1px solid #deddd7; border-radius: 5px; font: 11px/1 "IBM Plex Mono", monospace; }
  .group-filters { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 11px; }
  .group-filters button { padding: 7px 10px; color: #686d66; background: transparent; border: 1px solid #d8d7d0; border-radius: 7px; cursor: pointer; font-size: 12px; }
  .group-filters button:hover { color: #334a39; border-color: #aab5ac; }
  .group-filters button[aria-pressed="true"] { color: #fff; background: #536a59; border-color: #536a59; }
  .topic-group { margin-bottom: 72px; }
  .topic-group[hidden], .topic-card[hidden] { display: none; }
  .topic-group > header { display: grid; grid-template-columns: 32px auto 1fr; gap: 14px; align-items: center; margin-bottom: 22px; }
  .topic-group > header span, .topic-group > header b { color: #92968f; font: 10px/1 "IBM Plex Mono", monospace; font-weight: 400; }
  .topic-group > header h2 { margin: 0; font-size: 15px; letter-spacing: -.01em; }
  .topic-group > header b { display: flex; align-items: center; gap: 12px; }
  .topic-group > header b::before { content: ""; flex: 1; height: 1px; background: #d0d0c9; }
  .topic-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .topic-card { position: relative; min-height: 290px; overflow: hidden; background: #faf9f5; border: 1px solid #d8d8d1; border-radius: 15px; box-shadow: 0 10px 28px rgba(36,39,33,.035); transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
  .topic-card:hover { transform: translateY(-3px); border-color: #bcc5bd; box-shadow: 0 17px 42px rgba(36,45,37,.075); }
  .card-main { display: flex; flex-direction: column; height: 100%; padding: 30px; text-decoration: none; }
  .card-number { color: #92968f; font: 9px/1 "IBM Plex Mono", monospace; letter-spacing: .1em; }
  .card-main h3 { margin: 48px 0 15px; font-size: 31px; line-height: 1.15; letter-spacing: -.045em; }
  .card-main p { max-width: 390px; margin: 0; color: #696e67; font: 14px/1.8 "Noto Serif SC", serif; }
  .card-meta { display: flex; justify-content: space-between; gap: 18px; margin-top: auto; padding-top: 38px; color: #898d86; font-size: 11px; }
  .card-meta b { color: #405a47; font-weight: 600; }
  .card-meta i { display: inline-block; margin-left: 5px; font-style: normal; transition: transform .18s; }
  .topic-card:hover .card-meta i { transform: translateX(4px); }
  .pdf-link { position: absolute; top: 22px; right: 22px; padding: 7px 8px; color: #68736a; background: #edf0eb; border-radius: 5px; font: 9px/1 "IBM Plex Mono", monospace; letter-spacing: .08em; text-decoration: none; }
  .pdf-link:hover { color: #fff; background: #607465; }
  .no-topics { padding: 90px 20px; text-align: center; }
  .no-topics[hidden] { display: none; }
  .no-topics strong { display: block; font-size: 22px; }
  .no-topics p { margin: 12px 0 22px; color: #787d76; font: 14px/1.7 "Noto Serif SC", serif; }
  .no-topics button { padding: 0; color: #4d6754; background: none; border: 0; cursor: pointer; font-weight: 600; }
  .empty-topics { padding: 72px; background: #faf9f5; border: 1px solid #d9d8d1; border-radius: 18px; }
  .empty-topics > span { color: #999d96; font: 11px/1 "IBM Plex Mono", monospace; }
  .empty-topics h2 { margin: 70px 0 16px; font-size: clamp(30px, 4vw, 44px); }
  .empty-topics p { color: #6e736c; }
  footer { width: min(1120px, calc(100% - 48px)); margin: 0 auto; padding: 28px 0 36px; display: flex; justify-content: space-between; color: #898d86; border-top: 1px solid #dad9d3; font: 10px/1 "IBM Plex Mono", monospace; }
  @media (max-width: 720px) {
    main, footer { width: min(100% - 32px, 1040px); }
    main { padding: 62px 0 80px; }
    .page-header { margin-bottom: 48px; }
    .topic-controls { top: 6px; margin-bottom: 45px; padding: 10px; }
    .topic-grid { grid-template-columns: 1fr; }
    .topic-card { min-height: 270px; }
    .card-main { padding: 25px; }
    .card-main h3 { margin-top: 42px; }
    .topic-group { margin-bottom: 52px; }
  }
</style>
