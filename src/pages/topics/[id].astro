---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import { formatDate, getPublishedProblems, type ProblemEntry } from "../../lib/problems";
import {
  getProblemsForTopic,
  getPublishedTopics,
  type TopicEntry,
} from "../../lib/topics";

export async function getStaticPaths() {
  const topics = getPublishedTopics(await getCollection("topics"));
  const problems = getPublishedProblems(await getCollection("problems"));

  return topics.map((topic, index) => ({
    params: { id: topic.id },
    props: {
      topic,
      relatedProblems: getProblemsForTopic(topic, problems),
      previous: topics[index - 1] ?? null,
      next: topics[index + 1] ?? null,
    },
  }));
}

interface Props {
  topic: TopicEntry;
  relatedProblems: ProblemEntry[];
  previous: TopicEntry | null;
  next: TopicEntry | null;
}

const { topic, relatedProblems, previous, next } = Astro.props;
const { Content, headings } = await render(topic);
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showEditor = import.meta.env.DEV;
---

<BaseLayout
  title={`${topic.data.title} — 算法笔记`}
  description={topic.data.summary}
  themeColor="#f5f3ed"
>
  <div class="topic-page">
    <Navbar />

    <main>
      <a class="back-link" href="/topics">← 返回算法笔记</a>

      <header class="topic-header">
        <p class="eyebrow">ALGORITHM NOTE · {topic.data.group.toUpperCase()}</p>
        <h1>{topic.data.title}</h1>
        <p class="summary">{topic.data.summary}</p>
        <div class="header-meta">
          <span>更新于 {formatDate(topic.data.updatedAt)}</span>
          <i />
          <span>{relatedProblems.length} 道相关题目</span>
        </div>
        <div class="header-actions">
          <a class="read-active" href="#正文" aria-current="page">网页阅读</a>
          <a class="pdf-button" href={`/topics/${topic.id}.pdf`} target="_blank">
            打开 PDF
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3h8v8M13 3 4 12" /></svg>
          </a>
          {
            showEditor && (
              <a class="edit-button" href={`/topic-editor/?id=${encodeURIComponent(topic.id)}`}>
                编辑知识点
                <svg viewBox="0 0 16 16" aria-hidden="true">
                  <path d="m10.8 2.7 2.5 2.5M3 13l.7-3.2 7.8-7.8 2.5 2.5-7.8 7.8L3 13Z" />
                </svg>
              </a>
            )
          }
        </div>
      </header>

      <div id="正文" class="reading-layout">
        {
          outline.length > 0 && (
            <aside class="outline">
              <p>本页目录</p>
              <nav aria-label="专题目录">
                {outline.map((heading) => (
                  <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`}>
                    {heading.text}
                  </a>
                ))}
              </nav>
              <a class="outline-pdf" href={`/topics/${topic.id}.pdf`} target="_blank">
                <span>PDF EDITION</span>
                <strong>适合打印与离线复习</strong>
                <b>打开 →</b>
              </a>
            </aside>
          )
        }

        <article class="prose">
          <Content />
        </article>
      </div>

      {
        relatedProblems.length > 0 && (
          <section class="related">
            <header class="section-label">
              <span>RELATED</span>
              <h2>相关题目</h2>
              <b>{relatedProblems.length}</b>
            </header>
            <div class="related-list">
              {relatedProblems.map((problem) => (
                <a href={`/problems/${problem.id}`}>
                  <span>
                    <small>{problem.data.platform} · {formatDate(problem.data.solvedAt)}</small>
                    <strong>{problem.data.title}</strong>
                  </span>
                  <em>{problem.data.tags.join(" · ")}</em>
                  <b>→</b>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <nav class="topic-nav" aria-label="专题导航">
        {
          previous ? (
            <a href={`/topics/${previous.id}`}>
              <small>上一篇</small>
              <span>← {previous.data.title}</span>
            </a>
          ) : <span />
        }
        {
          next && (
            <a class="next" href={`/topics/${next.id}`}>
              <small>下一篇</small>
              <span>{next.data.title} →</span>
            </a>
          )
        }
      </nav>
    </main>

    <footer><span>{topic.data.group.toUpperCase()}</span><span>LAST UPDATED · {formatDate(topic.data.updatedAt)}</span></footer>
  </div>
</BaseLayout>

<style>
  :global(body) { background: #f5f3ed; color: #242620; }
  :global(html) { scroll-padding-top: 28px; }
  .topic-page { min-height: 100vh; }
  main { width: min(1040px, calc(100% - 48px)); margin: 0 auto; padding: 72px 0 120px; }
  .back-link { display: inline-block; margin-bottom: 66px; color: #777d75; font-size: 13px; text-decoration: none; }
  .back-link:hover { color: #354b3b; }
  .topic-header { max-width: 820px; margin: 0 auto; padding-bottom: 72px; text-align: center; border-bottom: 1px solid #d0d0c9; }
  .eyebrow { margin: 0 0 25px; color: #758078; font: 10px/1 "IBM Plex Mono", monospace; letter-spacing: .15em; }
  h1 { margin: 0; font-size: clamp(58px, 9vw, 92px); line-height: .98; letter-spacing: -.065em; font-weight: 650; text-wrap: balance; }
  .summary { max-width: 600px; margin: 28px auto 0; color: #676c65; font: 400 17px/1.85 "Noto Serif SC", serif; }
  .header-meta { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 26px; color: #8b8f88; font: 10px/1 "IBM Plex Mono", monospace; }
  .header-meta i { width: 3px; height: 3px; background: #989c95; border-radius: 50%; }
  .header-actions { display: inline-flex; gap: 4px; margin-top: 38px; padding: 4px; background: #e9e9e3; border-radius: 10px; }
  .header-actions a { display: flex; align-items: center; gap: 7px; min-height: 38px; padding: 0 14px; border-radius: 7px; font-size: 12px; font-weight: 600; text-decoration: none; }
  .read-active { color: #34493a; background: #fff; box-shadow: 0 2px 7px rgba(35,41,34,.07); }
  .pdf-button { color: #f8f8f4; background: #536a59; }
  .pdf-button:hover { background: #405647; }
  .edit-button { color: #536359; background: #f6f6f2; }
  .edit-button:hover { color: #fff; background: #718077; }
  .pdf-button svg, .edit-button svg { width: 14px; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  .reading-layout { display: grid; grid-template-columns: 220px minmax(0, 700px); gap: 72px; align-items: start; justify-content: center; padding: 82px 0 108px; }
  .outline { position: sticky; top: 28px; }
  .outline > p { margin: 0 0 19px; color: #858a82; font: 10px/1 "IBM Plex Mono", monospace; letter-spacing: .1em; text-transform: uppercase; }
  .outline nav { display: flex; flex-direction: column; padding-left: 14px; border-left: 1px solid #d4d5ce; }
  .outline nav a { padding: 6px 0; color: #747a72; font-size: 12px; line-height: 1.45; text-decoration: none; }
  .outline nav a:hover { color: #38503e; }
  .outline nav a.nested { padding-left: 12px; color: #92968f; font-size: 11px; }
  .outline-pdf { display: flex; flex-direction: column; margin-top: 34px; padding: 17px; color: inherit; background: #e9ede8; border-radius: 10px; text-decoration: none; }
  .outline-pdf span { color: #7f8a81; font: 8px/1 "IBM Plex Mono", monospace; letter-spacing: .12em; }
  .outline-pdf strong { margin-top: 10px; font: 500 12px/1.55 "Noto Serif SC", serif; }
  .outline-pdf b { margin-top: 13px; color: #48604f; font-size: 11px; }
  .prose { min-width: 0; color: #41443e; font: 400 16px/1.95 "Noto Serif SC", serif; }
  .prose :global(h2), .prose :global(h3) { color: #292c26; font-family: "Space Grotesk", "Noto Serif SC", sans-serif; }
  .prose :global(h2) { margin: 74px 0 20px; padding-top: 3px; font-size: 29px; line-height: 1.3; letter-spacing: -.035em; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h2)::before { content: "#"; margin-right: 10px; color: #8ca091; font: 400 15px/1 "IBM Plex Mono", monospace; vertical-align: 4px; }
  .prose :global(h3) { margin: 43px 0 14px; font-size: 20px; line-height: 1.4; letter-spacing: -.02em; }
  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(ul), .prose :global(ol) { margin: 18px 0 25px; padding-left: 1.45em; }
  .prose :global(li) { margin: 7px 0; padding-left: 4px; }
  .prose :global(a) { color: #43644c; text-underline-offset: 3px; }
  .prose :global(code) { padding: 2px 5px; color: #35513d; background: #e7ebe6; border-radius: 4px; font: .86em/1.55 "IBM Plex Mono", monospace; }
  .prose :global(pre) { margin: 25px 0 30px !important; padding: 22px !important; overflow: auto; background: #fff !important; border: 1px solid #dadbd4; border-radius: 11px; box-shadow: 0 10px 28px rgba(36,39,33,.04); font: 12px/1.75 "JetBrains Mono", monospace !important; }
  .prose :global(pre code) { padding: 0; background: transparent; border-radius: 0; font: inherit; }
  .prose :global(blockquote) { margin: 30px 0; padding: 5px 0 5px 22px; color: #696e67; border-left: 2px solid #879b8c; }
  .prose :global(table) { display: block; width: 100%; margin: 28px 0 34px; overflow-x: auto; border-spacing: 0; border-collapse: collapse; font-family: "Space Grotesk", "Noto Sans SC", sans-serif; font-size: 13px; line-height: 1.6; }
  .prose :global(th), .prose :global(td) { padding: 11px 13px; text-align: left; border-bottom: 1px solid #dcddd6; }
  .prose :global(th) { color: #51584f; background: #ebece7; font-weight: 600; }
  .prose :global(tr:last-child td) { border-bottom-color: #cccec6; }
  .related { padding: 74px 0 82px; border-top: 1px solid #d1d2ca; }
  .section-label { display: grid; grid-template-columns: 80px auto 1fr; gap: 17px; align-items: center; margin-bottom: 28px; }
  .section-label span, .section-label b { color: #91968e; font: 9px/1 "IBM Plex Mono", monospace; font-weight: 400; }
  .section-label h2 { margin: 0; font-size: 18px; }
  .section-label b { display: flex; align-items: center; gap: 12px; }
  .section-label b::before { content: ""; flex: 1; height: 1px; background: #d3d4cc; }
  .related-list { border-top: 1px solid #d0d1ca; }
  .related-list a { display: grid; grid-template-columns: minmax(220px,1fr) minmax(180px,.65fr) 20px; gap: 24px; align-items: center; min-height: 90px; padding: 17px 4px; color: inherit; border-bottom: 1px solid #dadbd4; text-decoration: none; }
  .related-list a > span { display: flex; flex-direction: column; gap: 7px; }
  .related-list small { color: #8b9088; font: 9px/1 "IBM Plex Mono", monospace; }
  .related-list strong { font-size: 17px; letter-spacing: -.015em; }
  .related-list em { overflow: hidden; color: #747a72; font-size: 11px; font-style: normal; text-overflow: ellipsis; white-space: nowrap; }
  .related-list a > b { font-weight: 400; transition: transform .18s; }
  .related-list a:hover > b { transform: translateX(4px); }
  .topic-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding-top: 32px; border-top: 1px solid #d0d1c9; }
  .topic-nav a { display: flex; flex-direction: column; gap: 10px; text-decoration: none; }
  .topic-nav a.next { text-align: right; }
  .topic-nav small { color: #8b9088; font-size: 10px; }
  .topic-nav span { font-size: 14px; font-weight: 600; }
  footer { width: min(1120px, calc(100% - 48px)); margin: 0 auto; padding: 28px 0 36px; display: flex; justify-content: space-between; color: #8b9088; border-top: 1px solid #ddddd7; font: 9px/1 "IBM Plex Mono", monospace; }
  @media (max-width: 820px) {
    main, footer { width: min(100% - 32px, 1040px); }
    main { padding: 52px 0 80px; }
    .back-link { margin-bottom: 48px; }
    .topic-header { padding-bottom: 54px; }
    .reading-layout { display: block; padding: 58px 0 76px; }
    .outline { position: static; margin-bottom: 48px; padding: 20px; background: #eeeee8; border-radius: 12px; }
    .outline nav { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 2px 14px; }
    .outline-pdf { display: none; }
    .prose :global(h2) { margin-top: 60px; font-size: 26px; }
    .related-list a { grid-template-columns: 1fr 20px; }
    .related-list em { grid-column: 1; }
    .related-list a > b { grid-column: 2; grid-row: 1 / span 2; }
  }
  @media (max-width: 520px) {
    .outline nav { grid-template-columns: 1fr; }
    .header-meta { flex-wrap: wrap; }
    .section-label { grid-template-columns: auto 1fr; }
    .section-label span { display: none; }
  }
</style>
